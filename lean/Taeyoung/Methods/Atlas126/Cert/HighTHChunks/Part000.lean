  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf35Signs i hi j hj k hk

theorem leaf35 {x d u : ℝ}
    (hx0 : (0 : ℝ) ≤ x)
    (hx1 : x ≤ (1/2 : ℝ))
    (hd0 : (1/2 : ℝ) ≤ d)
    (hd1 : d ≤ (1 : ℝ))
    (hu0 : (1/2 : ℝ) ≤ u)
    (hu1 : u ≤ (1 : ℝ)) : 0 ≤ highTHTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 7 4 3 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf35Certificate
  rwa [commonIdentity] at hb


