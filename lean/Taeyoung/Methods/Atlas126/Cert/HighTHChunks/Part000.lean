    ∀ k ∈ range 8, ∀ j ∈ range 5, ∀ h ∈ range 4,
      leaf35S3Numer k j h = ∑ i ∈ range 4, leaf35S2Numer k j i * leaf35W3Numer h i := by
  decide +kernel

