  leaf2S1Data.get ((i * 5 + j) * 4 + k)

private def leaf2S1 (i j k : ℕ) : ℚ :=
  (leaf2S1Numer i j k : ℚ) / 746496

private theorem leaf2S1NumerCorrect :
    ∀ h ∈ range 8, ∀ j ∈ range 5, ∀ k ∈ range 4,
      leaf2S1Numer h j k = ∑ i ∈ range 8, commonInputNumer i j k * leaf2W1Numer h i := by
  decide +kernel

private theorem leaf2S1Correct : Axis1Correct 7 4 3 leaf2W1 commonInput leaf2S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => commonInputNumer i j k) (leaf2W1Numer h) (leaf2S1Numer h j k) 5832 128 7
    (leaf2S1NumerCorrect h hh j hj k hk)
  norm_num only [show (5832 : ℚ)*128 = 746496 by norm_num] at he
  exact he

