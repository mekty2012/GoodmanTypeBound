private def leaf2W1Numer (k i : ℕ) : ℤ :=
  leaf2W1Data.get (k * 8 + i)

private def leaf2W1 (k i : ℕ) : ℚ :=
  (leaf2W1Numer k i : ℚ) / 128

private theorem leaf2W1NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf2W1Numer k i = intTransWeight 7 (0) 1 2 k i := by
  decide +kernel

private theorem leaf2W1Correct : WeightsCorrect 7 (0 : ℚ) ((1/2) : ℚ) leaf2W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (0) 1 2 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf2W1NumerCorrect k hk i hi] at he
  norm_num only [show (2 : ℚ)^7 = 128 by norm_num,
    show (0 : ℚ)/2 = 0 by norm_num,
    show (1 : ℚ)/2 = (1/2) by norm_num] at he
  simpa only [leaf2W1, neg_div] using he

