  (leaf5W1Numer k i : ℚ) / 1073741824

private theorem leaf5W1NumerCorrect :
    ∀ k ∈ range 11, ∀ i ∈ range 11,
      leaf5W1Numer k i = intTransWeight 10 (0) 5 8 k i := by
  decide +kernel

private theorem leaf5W1Correct : WeightsCorrect 10 (0 : ℚ) ((5/8) : ℚ) leaf5W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 10 (0) 5 8 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf5W1NumerCorrect k hk i hi] at he
  norm_num only [show (8 : ℚ)^10 = 1073741824 by norm_num,
    show (0 : ℚ)/8 = 0 by norm_num,
    show (5 : ℚ)/8 = (5/8) by norm_num] at he
  simpa only [leaf5W1, neg_div] using he

