private theorem leaf14S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf14S1Numer h j k = ∑ i ∈ range 11, leaf14InputNumer i j k * leaf14W1Numer h i := by
  decide +kernel

