  (leaf5InputNumer i j k : ℚ) / 129600

private theorem leaf5InputNumerCorrect :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf5InputNumer i j k = leaf5CoeffNumer i j k := by
  decide +kernel

private theorem leaf5InputCorrect :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf5Input i j k = leaf5Coeff i j k := by
  intro i hi j hj k hk
  exact congrArg (fun v : ℤ => (v : ℚ)/129600)
    (leaf5InputNumerCorrect i hi j hj k hk)

