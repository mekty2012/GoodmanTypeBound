  leaf10S3Data.get ((i * 8 + j) * 4 + k)

private def leaf10S3 (i j k : ℕ) : ℚ :=
  (leaf10S3Numer i j k : ℚ) / 40109257272846320906731624857600

private theorem leaf10S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf10S3Numer k j h = ∑ i ∈ range 4, leaf10S2Numer k j i * leaf10W3Numer h i := by
  decide +kernel

private theorem leaf10S3Correct : Axis3Correct 10 7 3 leaf10W3 leaf10S2 leaf10S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf10S2Numer k j i) (leaf10W3Numer h) (leaf10S3Numer k j h) 626707144888223764167681638400 64 3
    (leaf10S3NumerCorrect k hk j hj h hh)
  norm_num only [show (626707144888223764167681638400 : ℚ)*64 = 40109257272846320906731624857600 by norm_num] at he
  exact he

private theorem leaf10NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf10S3Numer i j k := by
  decide +kernel

private theorem leaf10Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf10S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf10NumerSigns i hi j hj k hk
  · norm_num


