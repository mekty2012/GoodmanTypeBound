  norm_num only [show (612018696179906019695001600 : ℚ)*64 = 39169196555513985260480102400 by norm_num] at he
  exact he

private theorem leaf5NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf5S3Numer i j k := by
  decide +kernel

private theorem leaf5Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf5S3 i j k := by
  intro i hi j hj k hk
