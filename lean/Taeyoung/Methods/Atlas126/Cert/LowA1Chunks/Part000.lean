private theorem leaf5S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf5S3Numer k j h = ∑ i ∈ range 4, leaf5S2Numer k j i * leaf5W3Numer h i := by
  decide +kernel

private theorem leaf5S3Correct : Axis3Correct 10 7 3 leaf5W3 leaf5S2 leaf5S3 := by
  intro k hk j hj h hh
