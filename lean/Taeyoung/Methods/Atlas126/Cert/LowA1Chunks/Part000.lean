private theorem leaf15S2NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf15S2Numer k j h = ∑ i ∈ range 8, leaf15S1Numer k i h * leaf15W2Numer j i := by
  decide +kernel

private theorem leaf15S2Correct : Axis2Correct 10 7 3 leaf15W2 leaf15S1 leaf15S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf15S1Numer k i h) (leaf15W2Numer j) (leaf15S2Numer k j h) 142496706959769600 4398046511104 7
    (leaf15S2NumerCorrect k hk j hj h hh)
  norm_num only [show (142496706959769600 : ℚ)*4398046511104 = 626707144888223764167681638400 by norm_num] at he
  exact he

