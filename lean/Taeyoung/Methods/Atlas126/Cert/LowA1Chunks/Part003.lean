    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf55S1Numer h j k = ∑ i ∈ range 11, leaf55InputNumer i j k * leaf55W1Numer h i := by
  decide +kernel

