private theorem leaf55CoeffExpansion (x d u : ℝ) :
    msum leaf55Coeff 10 7 3 x d u = sparseEval (leaf55CoeffTerms.map IntTerm.toRat) x d u / 129600 := by
  have he : ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf55CoeffNumer i j k = intSparseCoeff leaf55CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf55CoeffTerms, t.i ≤ 10 ∧ t.j ≤ 7 ∧ t.k ≤ 3 := by decide +kernel
  exact msum_intSparse_scaled leaf55CoeffNumer leaf55CoeffTerms 129600 10 7 3 he hb x d u

