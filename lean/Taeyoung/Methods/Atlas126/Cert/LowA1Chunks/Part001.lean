private theorem leaf32S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf32S1Numer h j k = ∑ i ∈ range 11, leaf32InputNumer i j k * leaf32W1Numer h i := by
  decide +kernel

private theorem leaf32S1Correct : Axis1Correct 10 7 3 leaf32W1 leaf32Input leaf32S1 := by
  intro h hh j hj k hk
