private def leaf32S3Numer (i j k : ℕ) : ℤ :=
  leaf32S3Data.get ((i * 8 + j) * 4 + k)

private def leaf32S3 (i j k : ℕ) : ℚ :=
  (leaf32S3Numer i j k : ℚ) / 42057604554132103791097020266682777600

private theorem leaf32S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf32S3Numer k j h = ∑ i ∈ range 4, leaf32S2Numer k j i * leaf32W3Numer h i := by
  decide +kernel

private theorem leaf32S3Correct : Axis3Correct 10 7 3 leaf32W3 leaf32S2 leaf32S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf32S2Numer k j i) (leaf32W3Numer h) (leaf32S3Numer k j h) 82143758894789265216986367708364800 512 3
    (leaf32S3NumerCorrect k hk j hj h hh)
  norm_num only [show (82143758894789265216986367708364800 : ℚ)*512 = 42057604554132103791097020266682777600 by norm_num] at he
  exact he

private theorem leaf32NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf32S3Numer i j k := by
  decide +kernel

private theorem leaf32Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf32S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf32NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf32Certificate :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ trans3 leaf32Coeff 10 7 3 (0 : ℚ) ((5/32) : ℚ) ((15/32) : ℚ) ((15/128) : ℚ) ((1/8) : ℚ) ((1/8) : ℚ) i j k := by
  have exactTable := checked_trans3 leaf32Coeff leaf32S1 leaf32S2 leaf32S3 10 7 3 (0 : ℚ) ((5/32) : ℚ) ((15/32) : ℚ) ((15/128) : ℚ) ((1/8) : ℚ) ((1/8) : ℚ) leaf32W1 leaf32W2 leaf32W3
    leaf32W1Correct leaf32W2Correct leaf32W3Correct
    (axis1Correct_of_table leaf32InputCorrect leaf32S1Correct) leaf32S2Correct leaf32S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf32Signs i hi j hj k hk

theorem leaf32 {x d u : ℝ}
    (hx0 : (0 : ℝ) ≤ x)
    (hx1 : x ≤ (5/32 : ℝ))
    (hd0 : (15/32 : ℝ) ≤ d)
    (hd1 : d ≤ (75/128 : ℝ))
    (hu0 : (1/8 : ℝ) ≤ u)
    (hu1 : u ≤ (1/4 : ℝ)) :
    0 ≤ aFace1Target x d u - (0 : ℝ) * aFace1Constraint0 x d u - (0 : ℝ) * aFace1Constraint1 x d u - (0 : ℝ) * aFace1Constraint2 x d u := by
  have h : 0 ≤ msum leaf32Coeff 10 7 3 x d u :=
    msum_nonneg_on_box leaf32Coeff 10 7 3
      (by norm_num) (by norm_num) (by norm_num)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith) leaf32Certificate
  rwa [leaf32Identity] at h


