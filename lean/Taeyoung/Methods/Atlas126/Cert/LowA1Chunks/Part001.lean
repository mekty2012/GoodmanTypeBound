  have he : ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf29CoeffNumer i j k = intSparseCoeff leaf29CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf29CoeffTerms, t.i ≤ 10 ∧ t.j ≤ 7 ∧ t.k ≤ 3 := by decide +kernel
  exact msum_intSparse_scaled leaf29CoeffNumer leaf29CoeffTerms 129600 10 7 3 he hb x d u

