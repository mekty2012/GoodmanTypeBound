private theorem leaf40CoeffExpansion (x d u : ℝ) :
    msum leaf40Coeff 10 7 3 x d u = sparseEval (leaf40CoeffTerms.map IntTerm.toRat) x d u / 129600 := by
  have he : ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf40CoeffNumer i j k = intSparseCoeff leaf40CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf40CoeffTerms, t.i ≤ 10 ∧ t.j ≤ 7 ∧ t.k ≤ 3 := by decide +kernel
  exact msum_intSparse_scaled leaf40CoeffNumer leaf40CoeffTerms 129600 10 7 3 he hb x d u

