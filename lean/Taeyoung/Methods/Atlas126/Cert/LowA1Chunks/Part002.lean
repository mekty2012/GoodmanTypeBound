  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf42S1Numer k i h) (leaf42W2Numer j) (leaf42S2Numer k j h) 142496706959769600 4398046511104 7
    (leaf42S2NumerCorrect k hk j hj h hh)
  norm_num only [show (142496706959769600 : ℚ)*4398046511104 = 626707144888223764167681638400 by norm_num] at he
  exact he

