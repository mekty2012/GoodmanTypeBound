private theorem leaf42S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf42S3Numer k j h = ∑ i ∈ range 4, leaf42S2Numer k j i * leaf42W3Numer h i := by
  decide +kernel

private theorem leaf42S3Correct : Axis3Correct 10 7 3 leaf42W3 leaf42S2 leaf42S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf42S2Numer k j i) (leaf42W3Numer h) (leaf42S3Numer k j h) 626707144888223764167681638400 8 3
    (leaf42S3NumerCorrect k hk j hj h hh)
  norm_num only [show (626707144888223764167681638400 : ℚ)*8 = 5013657159105790113341453107200 by norm_num] at he
  exact he

private theorem leaf42NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf42S3Numer i j k := by
  decide +kernel

private theorem leaf42Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf42S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf42NumerSigns i hi j hj k hk
  · norm_num


