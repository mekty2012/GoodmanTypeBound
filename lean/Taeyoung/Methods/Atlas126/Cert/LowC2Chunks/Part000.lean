private def leaf2S3Numer (i j k : ℕ) : ℤ :=
  leaf2S3Data.get ((i * 7 + j) * 4 + k)

private def leaf2S3 (i j k : ℕ) : ℚ :=
  (leaf2S3Numer i j k : ℚ) / 391691965555139852604801024

private theorem leaf2S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 7, ∀ h ∈ range 4,
      leaf2S3Numer k j h = ∑ i ∈ range 4, leaf2S2Numer k j i * leaf2W3Numer h i := by
  decide +kernel

private theorem leaf2S3Correct : Axis3Correct 10 6 3 leaf2W3 leaf2S2 leaf2S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf2S2Numer k j i) (leaf2W3Numer h) (leaf2S3Numer k j h) 391691965555139852604801024 1 3
    (leaf2S3NumerCorrect k hk j hj h hh)
  norm_num only [show (391691965555139852604801024 : ℚ)*1 = 391691965555139852604801024 by norm_num] at he
  exact he

private theorem leaf2NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ leaf2S3Numer i j k := by
  decide +kernel

private theorem leaf2Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ leaf2S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf2NumerSigns i hi j hj k hk
  · norm_num


