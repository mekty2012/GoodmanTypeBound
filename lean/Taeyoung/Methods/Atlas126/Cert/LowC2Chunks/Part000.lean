private theorem leaf2CoeffExpansion (x d u : ℝ) :
    msum leaf2Coeff 10 6 3 x d u = sparseEval (leaf2CoeffTerms.map IntTerm.toRat) x d u / 5184 := by
  have he : ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      leaf2CoeffNumer i j k = intSparseCoeff leaf2CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf2CoeffTerms, t.i ≤ 10 ∧ t.j ≤ 6 ∧ t.k ≤ 3 := by decide +kernel
  exact msum_intSparse_scaled leaf2CoeffNumer leaf2CoeffTerms 5184 10 6 3 he hb x d u

private theorem leaf2Identity (x d u : ℝ) :
    msum leaf2Coeff 10 6 3 x d u = cFace2Target x d u - (0 : ℝ) * cFace2Constraint0 x d u - (0 : ℝ) * cFace2Constraint1 x d u := by
  rw [leaf2CoeffExpansion]
