      leaf22W2Numer k i = intTransWeight 3 (0) 1 144 k i := by
  decide +kernel

private theorem leaf22W2Correct : WeightsCorrect 3 (0 : ℚ) ((1/144) : ℚ) leaf22W2 := by
  intro k hk i hi
  have he := intTransWeight_cast 3 (0) 1 144 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf22W2NumerCorrect k hk i hi] at he
  norm_num only [show (144 : ℚ)^3 = 2985984 by norm_num,
    show (0 : ℚ)/144 = 0 by norm_num,
    show (1 : ℚ)/144 = (1/144) by norm_num] at he
  simpa only [leaf22W2, neg_div] using he

