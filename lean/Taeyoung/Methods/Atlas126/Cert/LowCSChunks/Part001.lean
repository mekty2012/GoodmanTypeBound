private def leaf15W1Numer (k i : ℕ) : ℤ :=
  leaf15W1Data.get (k * 17 + i)

private def leaf15W1 (k i : ℕ) : ℚ :=
  (leaf15W1Numer k i : ℚ) / 1208925819614629174706176

private theorem leaf15W1NumerCorrect :
    ∀ k ∈ range 17, ∀ i ∈ range 17,
      leaf15W1Numer k i = intTransWeight 16 (25) 5 32 k i := by
  decide +kernel

private theorem leaf15W1Correct : WeightsCorrect 16 ((25/32) : ℚ) ((5/32) : ℚ) leaf15W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 16 (25) 5 32 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf15W1NumerCorrect k hk i hi] at he
  norm_num only [show (32 : ℚ)^16 = 1208925819614629174706176 by norm_num,
    show (25 : ℚ)/32 = (25/32) by norm_num,
    show (5 : ℚ)/32 = (5/32) by norm_num] at he
  simpa only [leaf15W1, neg_div] using he

