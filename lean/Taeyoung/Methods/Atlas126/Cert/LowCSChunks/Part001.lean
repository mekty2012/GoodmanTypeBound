private def leaf22S3Numer (i j k : ℕ) : ℤ :=
  leaf22S3Data.get ((i * 4 + j) * 8 + k)

private def leaf22S3 (i j k : ℕ) : ℚ :=
  (leaf22S3Numer i j k : ℚ) / 6826481469534132226345468985011882302969449237446656

private theorem leaf22S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf22S3Numer k j h = ∑ i ∈ range 8, leaf22S2Numer k j i * leaf22W3Numer h i := by
  decide +kernel

private theorem leaf22S3Correct : Axis3Correct 16 3 7 leaf22W3 leaf22S2 leaf22S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf22S2Numer k j i) (leaf22W3Numer h) (leaf22S3Numer k j h) 1552162182073091622975304968579594584064 4398046511104 7
    (leaf22S3NumerCorrect k hk j hj h hh)
  norm_num only [show (1552162182073091622975304968579594584064 : ℚ)*4398046511104 = 6826481469534132226345468985011882302969449237446656 by norm_num] at he
  exact he

private theorem leaf22NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf22S3Numer i j k := by
  decide +kernel

private theorem leaf22Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf22S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf22NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf22Certificate :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 16 3 7 ((25/32) : ℚ) ((5/32) : ℚ) (0 : ℚ) ((1/144) : ℚ) ((15/64) : ℚ) ((1/64) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf22S1 leaf22S2 leaf22S3 16 3 7 ((25/32) : ℚ) ((5/32) : ℚ) (0 : ℚ) ((1/144) : ℚ) ((15/64) : ℚ) ((1/64) : ℚ) leaf22W1 leaf22W2 leaf22W3
    leaf22W1Correct leaf22W2Correct leaf22W3Correct
    (axis1Correct_of_table commonInputCorrect leaf22S1Correct) leaf22S2Correct leaf22S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf22Signs i hi j hj k hk

