    (hx0 : (25/32 : ℝ) ≤ x)
    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (1/144 : ℝ))
    (hu0 : (15/64 : ℝ) ≤ u)
    (hu1 : u ≤ (1/4 : ℝ)) : 0 ≤ cSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 16 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf22Certificate
  rwa [commonIdentity] at hb


