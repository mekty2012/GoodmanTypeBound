private def leaf48W3Numer (k i : ℕ) : ℤ :=
  leaf48W3Data.get (k * 8 + i)

private def leaf48W3 (k i : ℕ) : ℚ :=
  (leaf48W3Numer k i : ℚ) / 34359738368

private theorem leaf48W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf48W3Numer k i = intTransWeight 7 (8) 1 32 k i := by
  decide +kernel

private theorem leaf48W3Correct : WeightsCorrect 7 ((1/4) : ℚ) ((1/32) : ℚ) leaf48W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (8) 1 32 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf48W3NumerCorrect k hk i hi] at he
  norm_num only [show (32 : ℚ)^7 = 34359738368 by norm_num,
    show (8 : ℚ)/32 = (1/4) by norm_num,
    show (1 : ℚ)/32 = (1/32) by norm_num] at he
  simpa only [leaf48W3, neg_div] using he

