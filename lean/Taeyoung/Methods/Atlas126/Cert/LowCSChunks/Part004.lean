  leaf48S3Data.get ((i * 4 + j) * 8 + k)

private def leaf48S3 (i j k : ℕ) : ℚ :=
  (leaf48S3Numer i j k : ℚ) / 53331886480735408018323976445405330491948822167552

private theorem leaf48S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf48S3Numer k j h = ∑ i ∈ range 8, leaf48S2Numer k j i * leaf48W3Numer h i := by
  decide +kernel

