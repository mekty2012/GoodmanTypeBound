private def leaf71S3Numer (i j k : ℕ) : ℤ :=
  leaf71S3Data.get ((i * 4 + j) * 8 + k)

private def leaf71S3 (i j k : ℕ) : ℚ :=
  (leaf71S3Numer i j k : ℚ) / 101722500764342132603309586420832310661218304

private theorem leaf71S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf71S3Numer k j h = ∑ i ∈ range 8, leaf71S2Numer k j i * leaf71W3Numer h i := by
  decide +kernel

private theorem leaf71S3Correct : Axis3Correct 16 3 7 leaf71W3 leaf71S2 leaf71S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf71S2Numer k j i) (leaf71W3Numer h) (leaf71S3Numer k j h) 2960514415880378004026994645270528 34359738368 7
    (leaf71S3NumerCorrect k hk j hj h hh)
  norm_num only [show (2960514415880378004026994645270528 : ℚ)*34359738368 = 101722500764342132603309586420832310661218304 by norm_num] at he
  exact he

private theorem leaf71NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf71S3Numer i j k := by
  decide +kernel

private theorem leaf71Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf71S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf71NumerSigns i hi j hj k hk
  · norm_num


