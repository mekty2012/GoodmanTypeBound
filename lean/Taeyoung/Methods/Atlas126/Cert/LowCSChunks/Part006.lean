private def leaf70S3Numer (i j k : ℕ) : ℤ :=
  leaf70S3Data.get ((i * 4 + j) * 8 + k)

private def leaf70S3 (i j k : ℕ) : ℚ :=
  (leaf70S3Numer i j k : ℚ) / 6666485810091926002290497055675666311493602770944

private theorem leaf70S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf70S3Numer k j h = ∑ i ∈ range 8, leaf70S2Numer k j i * leaf70W3Numer h i := by
  decide +kernel

private theorem leaf70S3Correct : Axis3Correct 16 3 7 leaf70W3 leaf70S2 leaf70S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf70S2Numer k j i) (leaf70W3Numer h) (leaf70S3Numer k j h) 194020272759136452871913121072449323008 34359738368 7
    (leaf70S3NumerCorrect k hk j hj h hh)
  norm_num only [show (194020272759136452871913121072449323008 : ℚ)*34359738368 = 6666485810091926002290497055675666311493602770944 by norm_num] at he
  exact he

private theorem leaf70NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf70S3Numer i j k := by
  decide +kernel

private theorem leaf70Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf70S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf70NumerSigns i hi j hj k hk
  · norm_num


