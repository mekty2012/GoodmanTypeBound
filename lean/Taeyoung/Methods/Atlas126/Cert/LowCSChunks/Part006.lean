private def leaf64W3Numer (k i : ℕ) : ℤ :=
  leaf64W3Data.get (k * 8 + i)

private def leaf64W3 (k i : ℕ) : ℚ :=
  (leaf64W3Numer k i : ℚ) / 268435456

private theorem leaf64W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf64W3Numer k i = intTransWeight 7 (5) 1 16 k i := by
  decide +kernel

private theorem leaf64W3Correct : WeightsCorrect 7 ((5/16) : ℚ) ((1/16) : ℚ) leaf64W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (5) 1 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf64W3NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^7 = 268435456 by norm_num,
    show (5 : ℚ)/16 = (5/16) by norm_num,
    show (1 : ℚ)/16 = (1/16) by norm_num] at he
  simpa only [leaf64W3, neg_div] using he

