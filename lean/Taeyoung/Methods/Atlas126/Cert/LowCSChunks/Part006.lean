private theorem leaf64S2NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf64S2Numer k j h = ∑ i ∈ range 4, leaf64S1Numer k i h * leaf64W2Numer j i := by
  decide +kernel

private theorem leaf64S2Correct : Axis2Correct 16 3 7 leaf64W2 leaf64S1 leaf64S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf64S1Numer k i h) (leaf64W2Numer j) (leaf64S2Numer k j h) 7931762302491582015247220736 46656 3
    (leaf64S2NumerCorrect k hk j hj h hh)
  norm_num only [show (7931762302491582015247220736 : ℚ)*46656 = 370064301985047250503374330658816 by norm_num] at he
  exact he

