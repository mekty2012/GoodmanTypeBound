private theorem leaf4S2NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf4S2Numer k j h = ∑ i ∈ range 4, leaf4S1Numer k i h * leaf4W2Numer j i := by
  decide +kernel

private theorem leaf4S2Correct : Axis2Correct 16 3 7 leaf4W2 leaf4S1 leaf4S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf4S1Numer k i h) (leaf4W2Numer j) (leaf4S2Numer k j h) 7931762302491582015247220736 5832 3
    (leaf4S2NumerCorrect k hk j hj h hh)
  norm_num only [show (7931762302491582015247220736 : ℚ)*5832 = 46258037748130906312921791332352 by norm_num] at he
  exact he

