private def leaf4W3Numer (k i : ℕ) : ℤ :=
  leaf4W3Data.get (k * 8 + i)

private def leaf4W3 (k i : ℕ) : ℚ :=
  (leaf4W3Numer k i : ℚ) / 2097152

private theorem leaf4W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf4W3Numer k i = intTransWeight 7 (0) 1 8 k i := by
  decide +kernel

private theorem leaf4W3Correct : WeightsCorrect 7 (0 : ℚ) ((1/8) : ℚ) leaf4W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (0) 1 8 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf4W3NumerCorrect k hk i hi] at he
  norm_num only [show (8 : ℚ)^7 = 2097152 by norm_num,
    show (0 : ℚ)/8 = 0 by norm_num,
    show (1 : ℚ)/8 = (1/8) by norm_num] at he
  simpa only [leaf4W3, neg_div] using he

