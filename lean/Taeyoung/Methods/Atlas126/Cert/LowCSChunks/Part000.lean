private def leaf4S3Numer (i j k : ℕ) : ℤ :=
  leaf4S3Data.get ((i * 4 + j) * 8 + k)

private def leaf4S3 (i j k : ℕ) : ℚ :=
  (leaf4S3Numer i j k : ℚ) / 97010136379568226435956560536224661504

private theorem leaf4S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf4S3Numer k j h = ∑ i ∈ range 8, leaf4S2Numer k j i * leaf4W3Numer h i := by
  decide +kernel

private theorem leaf4S3Correct : Axis3Correct 16 3 7 leaf4W3 leaf4S2 leaf4S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf4S2Numer k j i) (leaf4W3Numer h) (leaf4S3Numer k j h) 46258037748130906312921791332352 2097152 7
    (leaf4S3NumerCorrect k hk j hj h hh)
  norm_num only [show (46258037748130906312921791332352 : ℚ)*2097152 = 97010136379568226435956560536224661504 by norm_num] at he
  exact he

private theorem leaf4NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf4S3Numer i j k := by
  decide +kernel

private theorem leaf4Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf4S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf4NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf4Certificate :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((1/18) : ℚ) (0 : ℚ) ((1/8) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf4S1 leaf4S2 leaf4S3 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((1/18) : ℚ) (0 : ℚ) ((1/8) : ℚ) leaf4W1 leaf4W2 leaf4W3
    leaf4W1Correct leaf4W2Correct leaf4W3Correct
    (axis1Correct_of_table commonInputCorrect leaf4S1Correct) leaf4S2Correct leaf4S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf4Signs i hi j hj k hk

theorem leaf4 {x d u : ℝ}
    (hx0 : (5/8 : ℝ) ≤ x)
    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (1/18 : ℝ))
    (hu0 : (0 : ℝ) ≤ u)
    (hu1 : u ≤ (1/8 : ℝ)) : 0 ≤ cSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 16 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf4Certificate
  rwa [commonIdentity] at hb


