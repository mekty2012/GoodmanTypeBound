private def leaf6S3Numer (i j k : ℕ) : ℤ :=
  leaf6S3Data.get ((i * 4 + j) * 8 + k)

private def leaf6S3 (i j k : ℕ) : ℚ :=
  (leaf6S3Numer i j k : ℚ) / 12417297456584732983802439748636756672512

private theorem leaf6S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf6S3Numer k j h = ∑ i ∈ range 8, leaf6S2Numer k j i * leaf6W3Numer h i := by
  decide +kernel

private theorem leaf6S3Correct : Axis3Correct 16 3 7 leaf6W3 leaf6S2 leaf6S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf6S2Numer k j i) (leaf6W3Numer h) (leaf6S3Numer k j h) 46258037748130906312921791332352 268435456 7
    (leaf6S3NumerCorrect k hk j hj h hh)
  norm_num only [show (46258037748130906312921791332352 : ℚ)*268435456 = 12417297456584732983802439748636756672512 by norm_num] at he
  exact he

private theorem leaf6NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf6S3Numer i j k := by
  decide +kernel

private theorem leaf6Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf6S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf6NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf6Certificate :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((1/18) : ℚ) ((1/8) : ℚ) ((1/16) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf6S1 leaf6S2 leaf6S3 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((1/18) : ℚ) ((1/8) : ℚ) ((1/16) : ℚ) leaf6W1 leaf6W2 leaf6W3
    leaf6W1Correct leaf6W2Correct leaf6W3Correct
    (axis1Correct_of_table commonInputCorrect leaf6S1Correct) leaf6S2Correct leaf6S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf6Signs i hi j hj k hk

theorem leaf6 {x d u : ℝ}
    (hx0 : (5/8 : ℝ) ≤ x)
    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (1/18 : ℝ))
    (hu0 : (1/8 : ℝ) ≤ u)
    (hu1 : u ≤ (3/16 : ℝ)) : 0 ≤ cSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 16 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf6Certificate
  rwa [commonIdentity] at hb


