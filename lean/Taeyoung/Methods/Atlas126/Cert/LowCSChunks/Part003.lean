private def leaf36S3Numer (i j k : ℕ) : ℤ :=
  leaf36S3Data.get ((i * 4 + j) * 8 + k)

private def leaf36S3 (i j k : ℕ) : ℚ :=
  (leaf36S3Numer i j k : ℚ) / 794707037221422910963356143912752427040768

private theorem leaf36S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf36S3Numer k j h = ∑ i ∈ range 8, leaf36S2Numer k j i * leaf36W3Numer h i := by
  decide +kernel

private theorem leaf36S3Correct : Axis3Correct 16 3 7 leaf36W3 leaf36S2 leaf36S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf36S2Numer k j i) (leaf36W3Numer h) (leaf36S3Numer k j h) 2960514415880378004026994645270528 268435456 7
    (leaf36S3NumerCorrect k hk j hj h hh)
  norm_num only [show (2960514415880378004026994645270528 : ℚ)*268435456 = 794707037221422910963356143912752427040768 by norm_num] at he
  exact he

private theorem leaf36NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf36S3Numer i j k := by
  decide +kernel

private theorem leaf36Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf36S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf36NumerSigns i hi j hj k hk
  · norm_num


