  leaf38S3Data.get ((i * 4 + j) * 8 + k)

private def leaf38S3 (i j k : ℕ) : ℚ :=
  (leaf38S3Numer i j k : ℚ) / 757891690465376769030910629189255168

private theorem leaf38S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf38S3Numer k j h = ∑ i ∈ range 8, leaf38S2Numer k j i * leaf38W3Numer h i := by
  decide +kernel

private theorem leaf38S3Correct : Axis3Correct 16 3 7 leaf38W3 leaf38S2 leaf38S3 := by
  intro k hk j hj h hh
