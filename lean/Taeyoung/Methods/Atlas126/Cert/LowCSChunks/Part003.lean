private def leaf34S3Numer (i j k : ℕ) : ℤ :=
  leaf34S3Data.get ((i * 4 + j) * 8 + k)

private def leaf34S3 (i j k : ℕ) : ℚ :=
  (leaf34S3Numer i j k : ℚ) / 436894814050184462486110015040760467390044751196585984

private theorem leaf34S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf34S3Numer k j h = ∑ i ∈ range 8, leaf34S2Numer k j i * leaf34W3Numer h i := by
  decide +kernel

private theorem leaf34S3Correct : Axis3Correct 16 3 7 leaf34W3 leaf34S2 leaf34S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf34S2Numer k j i) (leaf34W3Numer h) (leaf34S3Numer k j h) 12715312595542766575413698302604038832652288 34359738368 7
    (leaf34S3NumerCorrect k hk j hj h hh)
  norm_num only [show (12715312595542766575413698302604038832652288 : ℚ)*34359738368 = 436894814050184462486110015040760467390044751196585984 by norm_num] at he
  exact he

private theorem leaf34NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf34S3Numer i j k := by
  decide +kernel

private theorem leaf34Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf34S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf34NumerSigns i hi j hj k hk
  · norm_num


