private def leaf37S3Numer (i j k : ℕ) : ℤ :=
  leaf37S3Data.get ((i * 4 + j) * 8 + k)

private def leaf37S3 (i j k : ℕ) : ℚ :=
  (leaf37S3Numer i j k : ℚ) / 794707037221422910963356143912752427040768

private theorem leaf37S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf37S3Numer k j h = ∑ i ∈ range 8, leaf37S2Numer k j i * leaf37W3Numer h i := by
  decide +kernel

private theorem leaf37S3Correct : Axis3Correct 16 3 7 leaf37W3 leaf37S2 leaf37S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf37S2Numer k j i) (leaf37W3Numer h) (leaf37S3Numer k j h) 2960514415880378004026994645270528 268435456 7
    (leaf37S3NumerCorrect k hk j hj h hh)
  norm_num only [show (2960514415880378004026994645270528 : ℚ)*268435456 = 794707037221422910963356143912752427040768 by norm_num] at he
  exact he

private theorem leaf37NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf37S3Numer i j k := by
  decide +kernel

private theorem leaf37Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf37S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf37NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf37Certificate :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) ((1/24) : ℚ) ((1/72) : ℚ) ((3/16) : ℚ) ((1/16) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf37S1 leaf37S2 leaf37S3 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) ((1/24) : ℚ) ((1/72) : ℚ) ((3/16) : ℚ) ((1/16) : ℚ) leaf37W1 leaf37W2 leaf37W3
    leaf37W1Correct leaf37W2Correct leaf37W3Correct
    (axis1Correct_of_table commonInputCorrect leaf37S1Correct) leaf37S2Correct leaf37S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf37Signs i hi j hj k hk

theorem leaf37 {x d u : ℝ}
    (hx0 : (5/8 : ℝ) ≤ x)
    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (1/24 : ℝ) ≤ d)
    (hd1 : d ≤ (1/18 : ℝ))
    (hu0 : (3/16 : ℝ) ≤ u)
    (hu1 : u ≤ (1/4 : ℝ)) : 0 ≤ cSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 16 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf37Certificate
  rwa [commonIdentity] at hb


