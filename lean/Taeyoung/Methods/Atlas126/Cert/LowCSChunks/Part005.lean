private def leaf57S3Numer (i j k : ℕ) : ℤ :=
  leaf57S3Data.get ((i * 4 + j) * 8 + k)

private def leaf57S3 (i j k : ℕ) : ℚ :=
  (leaf57S3Numer i j k : ℚ) / 3495158512401475699888880120326083739120358009572687872

private theorem leaf57S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf57S3Numer k j h = ∑ i ∈ range 8, leaf57S2Numer k j i * leaf57W3Numer h i := by
  decide +kernel

private theorem leaf57S3Correct : Axis3Correct 16 3 7 leaf57W3 leaf57S2 leaf57S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf57S2Numer k j i) (leaf57W3Numer h) (leaf57S3Numer k j h) 101722500764342132603309586420832310661218304 34359738368 7
    (leaf57S3NumerCorrect k hk j hj h hh)
  norm_num only [show (101722500764342132603309586420832310661218304 : ℚ)*34359738368 = 3495158512401475699888880120326083739120358009572687872 by norm_num] at he
  exact he

private theorem leaf57NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf57S3Numer i j k := by
  decide +kernel

private theorem leaf57Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf57S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf57NumerSigns i hi j hj k hk
  · norm_num


