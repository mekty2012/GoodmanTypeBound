private def leaf62S3Numer (i j k : ℕ) : ℤ :=
  leaf62S3Data.get ((i * 4 + j) * 8 + k)

private def leaf62S3 (i j k : ℕ) : ℚ :=
  (leaf62S3Numer i j k : ℚ) / 3495158512401475699888880120326083739120358009572687872

private theorem leaf62S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf62S3Numer k j h = ∑ i ∈ range 8, leaf62S2Numer k j i * leaf62W3Numer h i := by
  decide +kernel

private theorem leaf62S3Correct : Axis3Correct 16 3 7 leaf62W3 leaf62S2 leaf62S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf62S2Numer k j i) (leaf62W3Numer h) (leaf62S3Numer k j h) 101722500764342132603309586420832310661218304 34359738368 7
    (leaf62S3NumerCorrect k hk j hj h hh)
  norm_num only [show (101722500764342132603309586420832310661218304 : ℚ)*34359738368 = 3495158512401475699888880120326083739120358009572687872 by norm_num] at he
  exact he

