private theorem leaf73W1NumerCorrect :
    ∀ k ∈ range 17, ∀ i ∈ range 17,
      leaf73W1Numer k i = intTransWeight 16 (10) 5 16 k i := by
  decide +kernel

private theorem leaf73W1Correct : WeightsCorrect 16 ((5/8) : ℚ) ((5/16) : ℚ) leaf73W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 16 (10) 5 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf73W1NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^16 = 18446744073709551616 by norm_num,
    show (10 : ℚ)/16 = (5/8) by norm_num,
    show (5 : ℚ)/16 = (5/16) by norm_num] at he
  simpa only [leaf73W1, neg_div] using he

