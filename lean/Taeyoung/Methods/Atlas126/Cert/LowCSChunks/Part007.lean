private def leaf74S3Numer (i j k : ℕ) : ℤ :=
  leaf74S3Data.get ((i * 4 + j) * 8 + k)

private def leaf74S3 (i j k : ℕ) : ℚ :=
  (leaf74S3Numer i j k : ℚ) / 97010136379568226435956560536224661504

private theorem leaf74S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf74S3Numer k j h = ∑ i ∈ range 8, leaf74S2Numer k j i * leaf74W3Numer h i := by
  decide +kernel

private theorem leaf74S3Correct : Axis3Correct 16 3 7 leaf74W3 leaf74S2 leaf74S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf74S2Numer k j i) (leaf74W3Numer h) (leaf74S3Numer k j h) 46258037748130906312921791332352 2097152 7
    (leaf74S3NumerCorrect k hk j hj h hh)
  norm_num only [show (46258037748130906312921791332352 : ℚ)*2097152 = 97010136379568226435956560536224661504 by norm_num] at he
  exact he

private theorem leaf74NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf74S3Numer i j k := by
  decide +kernel

private theorem leaf74Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf74S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf74NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf74Certificate :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((1/18) : ℚ) ((3/8) : ℚ) ((1/8) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf74S1 leaf74S2 leaf74S3 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((1/18) : ℚ) ((3/8) : ℚ) ((1/8) : ℚ) leaf74W1 leaf74W2 leaf74W3
    leaf74W1Correct leaf74W2Correct leaf74W3Correct
    (axis1Correct_of_table commonInputCorrect leaf74S1Correct) leaf74S2Correct leaf74S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf74Signs i hi j hj k hk

theorem leaf74 {x d u : ℝ}
    (hx0 : (5/8 : ℝ) ≤ x)
    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (1/18 : ℝ))
    (hu0 : (3/8 : ℝ) ≤ u)
    (hu1 : u ≤ (1/2 : ℝ)) : 0 ≤ cSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 16 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf74Certificate
  rwa [commonIdentity] at hb


