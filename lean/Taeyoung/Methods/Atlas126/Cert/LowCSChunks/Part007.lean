private def leaf75S3Numer (i j k : ℕ) : ℤ :=
  leaf75S3Data.get ((i * 4 + j) * 8 + k)

private def leaf75S3 (i j k : ℕ) : ℚ :=
  (leaf75S3Numer i j k : ℚ) / 757891690465376769030910629189255168

private theorem leaf75S3NumerCorrect :
    ∀ k ∈ range 17, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf75S3Numer k j h = ∑ i ∈ range 8, leaf75S2Numer k j i * leaf75W3Numer h i := by
  decide +kernel

private theorem leaf75S3Correct : Axis3Correct 16 3 7 leaf75W3 leaf75S2 leaf75S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf75S2Numer k j i) (leaf75W3Numer h) (leaf75S3Numer k j h) 46258037748130906312921791332352 16384 7
    (leaf75S3NumerCorrect k hk j hj h hh)
  norm_num only [show (46258037748130906312921791332352 : ℚ)*16384 = 757891690465376769030910629189255168 by norm_num] at he
  exact he

private theorem leaf75NumerSigns :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf75S3Numer i j k := by
  decide +kernel

private theorem leaf75Signs :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf75S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf75NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf75Certificate :
    ∀ i ∈ range 17, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) ((1/18) : ℚ) ((1/18) : ℚ) ((1/4) : ℚ) ((1/4) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf75S1 leaf75S2 leaf75S3 16 3 7 ((5/8) : ℚ) ((5/16) : ℚ) ((1/18) : ℚ) ((1/18) : ℚ) ((1/4) : ℚ) ((1/4) : ℚ) leaf75W1 leaf75W2 leaf75W3
    leaf75W1Correct leaf75W2Correct leaf75W3Correct
    (axis1Correct_of_table commonInputCorrect leaf75S1Correct) leaf75S2Correct leaf75S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf75Signs i hi j hj k hk

theorem leaf75 {x d u : ℝ}
    (hx0 : (5/8 : ℝ) ≤ x)
    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (1/18 : ℝ) ≤ d)
    (hd1 : d ≤ (1/9 : ℝ))
    (hu0 : (1/4 : ℝ) ≤ u)
    (hu1 : u ≤ (1/2 : ℝ)) : 0 ≤ cSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 16 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf75Certificate
  rwa [commonIdentity] at hb


