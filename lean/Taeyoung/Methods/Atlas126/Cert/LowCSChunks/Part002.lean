private theorem leaf30W1Correct : WeightsCorrect 16 ((55/64) : ℚ) ((5/64) : ℚ) leaf30W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 16 (55) 5 64 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf30W1NumerCorrect k hk i hi] at he
  norm_num only [show (64 : ℚ)^16 = 79228162514264337593543950336 by norm_num,
    show (55 : ℚ)/64 = (55/64) by norm_num,
    show (5 : ℚ)/64 = (5/64) by norm_num] at he
  simpa only [leaf30W1, neg_div] using he

