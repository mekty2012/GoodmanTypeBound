private def leaf28W3Numer (k i : ℕ) : ℤ :=
  leaf28W3Data.get (k * 8 + i)

private def leaf28W3 (k i : ℕ) : ℚ :=
  (leaf28W3Numer k i : ℚ) / 4398046511104

private theorem leaf28W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf28W3Numer k i = intTransWeight 7 (15) 1 64 k i := by
  decide +kernel

private theorem leaf28W3Correct : WeightsCorrect 7 ((15/64) : ℚ) ((1/64) : ℚ) leaf28W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (15) 1 64 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf28W3NumerCorrect k hk i hi] at he
  norm_num only [show (64 : ℚ)^7 = 4398046511104 by norm_num,
    show (15 : ℚ)/64 = (15/64) by norm_num,
    show (1 : ℚ)/64 = (1/64) by norm_num] at he
  simpa only [leaf28W3, neg_div] using he

