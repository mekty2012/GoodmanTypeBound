private def leaf27W1 (k i : ℕ) : ℚ :=
  (leaf27W1Numer k i : ℚ) / 79228162514264337593543950336

private theorem leaf27W1NumerCorrect :
    ∀ k ∈ range 17, ∀ i ∈ range 17,
      leaf27W1Numer k i = intTransWeight 16 (50) 5 64 k i := by
  decide +kernel

private theorem leaf27W1Correct : WeightsCorrect 16 ((25/32) : ℚ) ((5/64) : ℚ) leaf27W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 16 (50) 5 64 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf27W1NumerCorrect k hk i hi] at he
  norm_num only [show (64 : ℚ)^16 = 79228162514264337593543950336 by norm_num,
    show (50 : ℚ)/64 = (25/32) by norm_num,
    show (5 : ℚ)/64 = (5/64) by norm_num] at he
  simpa only [leaf27W1, neg_div] using he

