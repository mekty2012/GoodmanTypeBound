private def leaf22W1Numer (k i : ℕ) : ℤ :=
  leaf22W1Data.get (k * 13 + i)

private def leaf22W1 (k i : ℕ) : ℚ :=
  (leaf22W1Numer k i : ℚ) / 1152921504606846976

private theorem leaf22W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf22W1Numer k i = intTransWeight 12 (0) 5 32 k i := by
  decide +kernel

private theorem leaf22W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/32) : ℚ) leaf22W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 32 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf22W1NumerCorrect k hk i hi] at he
  norm_num only [show (32 : ℚ)^12 = 1152921504606846976 by norm_num,
    show (0 : ℚ)/32 = 0 by norm_num,
    show (5 : ℚ)/32 = (5/32) by norm_num] at he
  simpa only [leaf22W1, neg_div] using he

