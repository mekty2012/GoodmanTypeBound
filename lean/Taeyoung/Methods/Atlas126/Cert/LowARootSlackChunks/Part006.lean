private def leaf105W1Numer (k i : ℕ) : ℤ :=
  leaf105W1Data.get (k * 13 + i)

private def leaf105W1 (k i : ℕ) : ℚ :=
  (leaf105W1Numer k i : ℚ) / 79228162514264337593543950336

private theorem leaf105W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf105W1Numer k i = intTransWeight 12 (0) 5 256 k i := by
  decide +kernel

private theorem leaf105W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/256) : ℚ) leaf105W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 256 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf105W1NumerCorrect k hk i hi] at he
  norm_num only [show (256 : ℚ)^12 = 79228162514264337593543950336 by norm_num,
    show (0 : ℚ)/256 = 0 by norm_num,
    show (5 : ℚ)/256 = (5/256) by norm_num] at he
  simpa only [leaf105W1, neg_div] using he

