private def leaf36W1 (k i : ℕ) : ℚ :=
  (leaf36W1Numer k i : ℚ) / 4722366482869645213696

private theorem leaf36W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf36W1Numer k i = intTransWeight 12 (0) 5 64 k i := by
  decide +kernel

private theorem leaf36W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/64) : ℚ) leaf36W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 64 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf36W1NumerCorrect k hk i hi] at he
  norm_num only [show (64 : ℚ)^12 = 4722366482869645213696 by norm_num,
    show (0 : ℚ)/64 = 0 by norm_num,
    show (5 : ℚ)/64 = (5/64) by norm_num] at he
  simpa only [leaf36W1, neg_div] using he

