      leaf45S2Numer k j h = ∑ i ∈ range 4, leaf45S1Numer k i h * leaf45W2Numer j i := by
  decide +kernel

private theorem leaf45S2Correct : Axis2Correct 12 3 7 leaf45W2 leaf45S1 leaf45S2 := by
