    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf40S3Numer i j k := by
  decide +kernel

private theorem leaf40Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf40S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf40NumerSigns i hi j hj k hk
  · norm_num


