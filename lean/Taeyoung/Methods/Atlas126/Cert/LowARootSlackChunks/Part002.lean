  leaf40S3Data.get ((i * 4 + j) * 8 + k)

private def leaf40S3 (i j k : ℕ) : ℚ :=
  (leaf40S3Numer i j k : ℚ) / 34682118932754825109716349057622731814100742963200

private theorem leaf40S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf40S3Numer k j h = ∑ i ∈ range 8, leaf40S2Numer k j i * leaf40W3Numer h i := by
  decide +kernel

private theorem leaf40S3Correct : Axis3Correct 12 3 7 leaf40W3 leaf40S2 leaf40S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf40S2Numer k j i) (leaf40W3Numer h) (leaf40S3Numer k j h) 7885800853899769460830691300003020800 4398046511104 7
    (leaf40S3NumerCorrect k hk j hj h hh)
  norm_num only [show (7885800853899769460830691300003020800 : ℚ)*4398046511104 = 34682118932754825109716349057622731814100742963200 by norm_num] at he
  exact he

