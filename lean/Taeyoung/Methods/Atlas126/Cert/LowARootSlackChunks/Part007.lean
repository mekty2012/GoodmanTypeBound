private def leaf114W1 (k i : ℕ) : ℚ :=
  (leaf114W1Numer k i : ℚ) / 19342813113834066795298816

private theorem leaf114W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf114W1Numer k i = intTransWeight 12 (0) 5 128 k i := by
  decide +kernel

private theorem leaf114W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/128) : ℚ) leaf114W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 128 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf114W1NumerCorrect k hk i hi] at he
  norm_num only [show (128 : ℚ)^12 = 19342813113834066795298816 by norm_num,
    show (0 : ℚ)/128 = 0 by norm_num,
    show (5 : ℚ)/128 = (5/128) by norm_num] at he
  simpa only [leaf114W1, neg_div] using he

