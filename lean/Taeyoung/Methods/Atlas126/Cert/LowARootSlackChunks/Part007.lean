private def leaf120W3Numer (k i : ℕ) : ℤ :=
  leaf120W3Data.get (k * 8 + i)

private def leaf120W3 (k i : ℕ) : ℚ :=
  (leaf120W3Numer k i : ℚ) / 4398046511104

private theorem leaf120W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf120W3Numer k i = intTransWeight 7 (17) 1 64 k i := by
  decide +kernel

private theorem leaf120W3Correct : WeightsCorrect 7 ((17/64) : ℚ) ((1/64) : ℚ) leaf120W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (17) 1 64 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf120W3NumerCorrect k hk i hi] at he
  norm_num only [show (64 : ℚ)^7 = 4398046511104 by norm_num,
    show (17 : ℚ)/64 = (17/64) by norm_num,
    show (1 : ℚ)/64 = (1/64) by norm_num] at he
  simpa only [leaf120W3, neg_div] using he

