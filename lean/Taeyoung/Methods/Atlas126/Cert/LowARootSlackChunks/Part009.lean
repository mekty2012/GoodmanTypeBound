private theorem leaf142S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf142S3Numer k j h = ∑ i ∈ range 8, leaf142S2Numer k j i * leaf142W3Numer h i := by
  decide +kernel

private theorem leaf142S3Correct : Axis3Correct 12 3 7 leaf142W3 leaf142S2 leaf142S3 := by
