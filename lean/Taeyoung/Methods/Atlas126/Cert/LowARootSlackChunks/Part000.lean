private def leaf11S3Numer (i j k : ℕ) : ℤ :=
  leaf11S3Data.get ((i * 4 + j) * 8 + k)

private def leaf11S3 (i j k : ℕ) : ℚ :=
  (leaf11S3Numer i j k : ℚ) / 481311087274155850880779498291200

private theorem leaf11S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf11S3Numer k j h = ∑ i ∈ range 8, leaf11S2Numer k j i * leaf11W3Numer h i := by
  decide +kernel

private theorem leaf11S3Correct : Axis3Correct 12 3 7 leaf11W3 leaf11S2 leaf11S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf11S2Numer k j i) (leaf11W3Numer h) (leaf11S3Numer k j h) 1793023523964568417075200 268435456 7
    (leaf11S3NumerCorrect k hk j hj h hh)
  norm_num only [show (1793023523964568417075200 : ℚ)*268435456 = 481311087274155850880779498291200 by norm_num] at he
  exact he

private theorem leaf11NumerSigns :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf11S3Numer i j k := by
  decide +kernel

private theorem leaf11Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf11S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf11NumerSigns i hi j hj k hk
  · norm_num


