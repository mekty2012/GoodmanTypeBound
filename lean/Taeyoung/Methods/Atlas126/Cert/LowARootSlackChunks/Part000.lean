private def leaf7W1Numer (k i : ℕ) : ℤ :=
  leaf7W1Data.get (k * 13 + i)

private def leaf7W1 (k i : ℕ) : ℚ :=
  (leaf7W1Numer k i : ℚ) / 281474976710656

private theorem leaf7W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf7W1Numer k i = intTransWeight 12 (0) 5 16 k i := by
  decide +kernel

private theorem leaf7W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/16) : ℚ) leaf7W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf7W1NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^12 = 281474976710656 by norm_num,
    show (0 : ℚ)/16 = 0 by norm_num,
    show (5 : ℚ)/16 = (5/16) by norm_num] at he
  simpa only [leaf7W1, neg_div] using he

