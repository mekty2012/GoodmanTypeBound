private theorem leaf16S2NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf16S2Numer k j h = ∑ i ∈ range 4, leaf16S1Numer k i h * leaf16W2Numer j i := by
  decide +kernel

private theorem leaf16S2Correct : Axis2Correct 12 3 7 leaf16W2 leaf16S1 leaf16S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf16S1Numer k i h) (leaf16W2Numer j) (leaf16S2Numer k j h) 437749883780412211200 512 3
    (leaf16S2NumerCorrect k hk j hj h hh)
  norm_num only [show (437749883780412211200 : ℚ)*512 = 224127940495571052134400 by norm_num] at he
  exact he

