    ∀ h ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf14S1Numer h j k = ∑ i ∈ range 13, commonInputNumer i j k * leaf14W1Numer h i := by
  decide +kernel

