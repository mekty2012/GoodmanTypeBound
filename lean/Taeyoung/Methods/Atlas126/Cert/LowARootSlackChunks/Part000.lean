private theorem leaf14S2NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf14S2Numer k j h = ∑ i ∈ range 4, leaf14S1Numer k i h * leaf14W2Numer j i := by
  decide +kernel

private theorem leaf14S2Correct : Axis2Correct 12 3 7 leaf14W2 leaf14S1 leaf14S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf14S1Numer k i h) (leaf14W2Numer j) (leaf14S2Numer k j h) 437749883780412211200 4096 3
    (leaf14S2NumerCorrect k hk j hj h hh)
  norm_num only [show (437749883780412211200 : ℚ)*4096 = 1793023523964568417075200 by norm_num] at he
  exact he

