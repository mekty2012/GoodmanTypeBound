private def leaf16S3Numer (i j k : ℕ) : ℤ :=
  leaf16S3Data.get ((i * 4 + j) * 8 + k)

private def leaf16S3 (i j k : ℕ) : ℚ :=
  (leaf16S3Numer i j k : ℚ) / 470030358666167823125761228800

private theorem leaf16S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf16S3Numer k j h = ∑ i ∈ range 8, leaf16S2Numer k j i * leaf16W3Numer h i := by
  decide +kernel

private theorem leaf16S3Correct : Axis3Correct 12 3 7 leaf16W3 leaf16S2 leaf16S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf16S2Numer k j i) (leaf16W3Numer h) (leaf16S3Numer k j h) 224127940495571052134400 2097152 7
    (leaf16S3NumerCorrect k hk j hj h hh)
  norm_num only [show (224127940495571052134400 : ℚ)*2097152 = 470030358666167823125761228800 by norm_num] at he
  exact he

private theorem leaf16NumerSigns :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf16S3Numer i j k := by
  decide +kernel

private theorem leaf16Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf16S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf16NumerSigns i hi j hj k hk
  · norm_num


