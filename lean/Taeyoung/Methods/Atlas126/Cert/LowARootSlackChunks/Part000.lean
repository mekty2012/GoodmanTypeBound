private theorem leaf13S1NumerCorrect :
    ∀ h ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf13S1Numer h j k = ∑ i ∈ range 13, commonInputNumer i j k * leaf13W1Numer h i := by
  decide +kernel

