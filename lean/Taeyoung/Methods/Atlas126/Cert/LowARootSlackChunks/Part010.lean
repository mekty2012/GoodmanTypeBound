private def leaf144W1Numer (k i : ℕ) : ℤ :=
  leaf144W1Data.get (k * 13 + i)

private def leaf144W1 (k i : ℕ) : ℚ :=
  (leaf144W1Numer k i : ℚ) / 68719476736

private theorem leaf144W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf144W1Numer k i = intTransWeight 12 (0) 5 8 k i := by
  decide +kernel

private theorem leaf144W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/8) : ℚ) leaf144W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 8 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf144W1NumerCorrect k hk i hi] at he
  norm_num only [show (8 : ℚ)^12 = 68719476736 by norm_num,
    show (0 : ℚ)/8 = 0 by norm_num,
    show (5 : ℚ)/8 = (5/8) by norm_num] at he
  simpa only [leaf144W1, neg_div] using he

