private def leaf128S3Numer (i j k : ℕ) : ℤ :=
  leaf128S3Data.get ((i * 4 + j) * 8 + k)

private def leaf128S3 (i j k : ℕ) : ℚ :=
  (leaf128S3Numer i j k : ℚ) / 1971450213474942365207672825000755200

private theorem leaf128S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf128S3Numer k j h = ∑ i ∈ range 8, leaf128S2Numer k j i * leaf128W3Numer h i := by
  decide +kernel

private theorem leaf128S3Correct : Axis3Correct 12 3 7 leaf128W3 leaf128S2 leaf128S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf128S2Numer k j i) (leaf128W3Numer h) (leaf128S3Numer k j h) 7344224354158872236340019200 268435456 7
    (leaf128S3NumerCorrect k hk j hj h hh)
  norm_num only [show (7344224354158872236340019200 : ℚ)*268435456 = 1971450213474942365207672825000755200 by norm_num] at he
  exact he

private theorem leaf128NumerSigns :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf128S3Numer i j k := by
  decide +kernel

private theorem leaf128Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf128S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf128NumerSigns i hi j hj k hk
  · norm_num


