private def leaf123W1 (k i : ℕ) : ℚ :=
  (leaf123W1Numer k i : ℚ) / 1152921504606846976

private theorem leaf123W1NumerCorrect :
    ∀ k ∈ range 13, ∀ i ∈ range 13,
      leaf123W1Numer k i = intTransWeight 12 (0) 5 32 k i := by
  decide +kernel

private theorem leaf123W1Correct : WeightsCorrect 12 (0 : ℚ) ((5/32) : ℚ) leaf123W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 12 (0) 5 32 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf123W1NumerCorrect k hk i hi] at he
  norm_num only [show (32 : ℚ)^12 = 1152921504606846976 by norm_num,
    show (0 : ℚ)/32 = 0 by norm_num,
    show (5 : ℚ)/32 = (5/32) by norm_num] at he
  simpa only [leaf123W1, neg_div] using he

