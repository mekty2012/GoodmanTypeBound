private def leaf57S3Numer (i j k : ℕ) : ℤ :=
  leaf57S3Data.get ((i * 4 + j) * 8 + k)

private def leaf57S3 (i j k : ℕ) : ℚ :=
  (leaf57S3Numer i j k : ℚ) / 33869256770268383896207372126584699037207756800

private theorem leaf57S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf57S3Numer k j h = ∑ i ∈ range 8, leaf57S2Numer k j i * leaf57W3Numer h i := by
  decide +kernel

private theorem leaf57S3Correct : Axis3Correct 12 3 7 leaf57W3 leaf57S2 leaf57S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf57S2Numer k j i) (leaf57W3Numer h) (leaf57S3Numer k j h) 985725106737471182603836412500377600 34359738368 7
    (leaf57S3NumerCorrect k hk j hj h hh)
  norm_num only [show (985725106737471182603836412500377600 : ℚ)*34359738368 = 33869256770268383896207372126584699037207756800 by norm_num] at he
  exact he

private theorem leaf57NumerSigns :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf57S3Numer i j k := by
  decide +kernel

private theorem leaf57Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf57S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf57NumerSigns i hi j hj k hk
  · norm_num


