      leaf67S2Numer k j h = ∑ i ∈ range 4, leaf67S1Numer k i h * leaf67W2Numer j i := by
  decide +kernel

private theorem leaf67S2Correct : Axis2Correct 12 3 7 leaf67W2 leaf67S1 leaf67S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf67S1Numer k i h) (leaf67W2Numer j) (leaf67S2Numer k j h) 437749883780412211200 4096 3
    (leaf67S2NumerCorrect k hk j hj h hh)
