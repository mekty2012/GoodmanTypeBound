private def leaf67W3Numer (k i : ℕ) : ℤ :=
  leaf67W3Data.get (k * 8 + i)

private def leaf67W3 (k i : ℕ) : ℚ :=
  (leaf67W3Numer k i : ℚ) / 268435456

private theorem leaf67W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf67W3Numer k i = intTransWeight 7 (3) 1 16 k i := by
  decide +kernel

private theorem leaf67W3Correct : WeightsCorrect 7 ((3/16) : ℚ) ((1/16) : ℚ) leaf67W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (3) 1 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf67W3NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^7 = 268435456 by norm_num,
    show (3 : ℚ)/16 = (3/16) by norm_num,
    show (1 : ℚ)/16 = (1/16) by norm_num] at he
  simpa only [leaf67W3, neg_div] using he

