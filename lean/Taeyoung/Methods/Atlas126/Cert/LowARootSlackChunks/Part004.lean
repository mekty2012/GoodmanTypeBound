private theorem leaf68S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf68S3Numer k j h = ∑ i ∈ range 8, leaf68S2Numer k j i * leaf68W3Numer h i := by
  decide +kernel

private theorem leaf68S3Correct : Axis3Correct 12 3 7 leaf68W3 leaf68S2 leaf68S3 := by
