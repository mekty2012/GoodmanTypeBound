private theorem leaf67S1NumerCorrect :
    ∀ h ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf67S1Numer h j k = ∑ i ∈ range 13, commonInputNumer i j k * leaf67W1Numer h i := by
  decide +kernel

private theorem leaf67S1Correct : Axis1Correct 12 3 7 leaf67W1 commonInput leaf67S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => commonInputNumer i j k) (leaf67W1Numer h) (leaf67S1Numer h j k) 1555200 281474976710656 12
    (leaf67S1NumerCorrect h hh j hj k hk)
  norm_num only [show (1555200 : ℚ)*281474976710656 = 437749883780412211200 by norm_num] at he
  exact he

