  leaf64S3Data.get ((i * 4 + j) * 8 + k)

private def leaf64S3 (i j k : ℕ) : ℚ :=
  (leaf64S3Numer i j k : ℚ) / 60163885909269481360097437286400

private theorem leaf64S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf64S3Numer k j h = ∑ i ∈ range 8, leaf64S2Numer k j i * leaf64W3Numer h i := by
  decide +kernel

private theorem leaf64S3Correct : Axis3Correct 12 3 7 leaf64W3 leaf64S2 leaf64S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf64S2Numer k j i) (leaf64W3Numer h) (leaf64S3Numer k j h) 224127940495571052134400 268435456 7
    (leaf64S3NumerCorrect k hk j hj h hh)
  norm_num only [show (224127940495571052134400 : ℚ)*268435456 = 60163885909269481360097437286400 by norm_num] at he
  exact he

private theorem leaf64NumerSigns :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf64S3Numer i j k := by
  decide +kernel

private theorem leaf64Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf64S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf64NumerSigns i hi j hj k hk
  · norm_num


