  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => commonInputNumer i j k) (leaf80W1Numer h) (leaf80S1Numer h j k) 1555200 281474976710656 12
    (leaf80S1NumerCorrect h hh j hj k hk)
