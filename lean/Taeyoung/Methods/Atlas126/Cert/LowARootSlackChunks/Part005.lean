private def leaf85S3Numer (i j k : ℕ) : ℤ :=
  leaf85S3Data.get ((i * 4 + j) * 8 + k)

private def leaf85S3 (i j k : ℕ) : ℚ :=
  (leaf85S3Numer i j k : ℚ) / 112063970247785526067200

private theorem leaf85S3NumerCorrect :
    ∀ k ∈ range 13, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf85S3Numer k j h = ∑ i ∈ range 8, leaf85S2Numer k j i * leaf85W3Numer h i := by
  decide +kernel

private theorem leaf85S3Correct : Axis3Correct 12 3 7 leaf85W3 leaf85S2 leaf85S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf85S2Numer k j i) (leaf85W3Numer h) (leaf85S3Numer k j h) 6839841934068940800 16384 7
    (leaf85S3NumerCorrect k hk j hj h hh)
  norm_num only [show (6839841934068940800 : ℚ)*16384 = 112063970247785526067200 by norm_num] at he
  exact he

private theorem leaf85NumerSigns :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf85S3Numer i j k := by
  decide +kernel

private theorem leaf85Signs :
    ∀ i ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf85S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf85NumerSigns i hi j hj k hk
  · norm_num


