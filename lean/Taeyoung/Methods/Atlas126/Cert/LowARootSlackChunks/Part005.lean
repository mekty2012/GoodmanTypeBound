private theorem leaf80S1NumerCorrect :
    ∀ h ∈ range 13, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf80S1Numer h j k = ∑ i ∈ range 13, commonInputNumer i j k * leaf80W1Numer h i := by
  decide +kernel

