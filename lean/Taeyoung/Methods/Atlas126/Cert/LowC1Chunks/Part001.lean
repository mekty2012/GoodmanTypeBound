  leaf18S1Data.get ((i * 8 + j) * 4 + k)

private def leaf18S1 (i j k : ℕ) : ℚ :=
  (leaf18S1Numer i j k : ℚ) / 11399736556781568

private theorem leaf18S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf18S1Numer h j k = ∑ i ∈ range 11, leaf18InputNumer i j k * leaf18W1Numer h i := by
  decide +kernel

private theorem leaf18S1Correct : Axis1Correct 10 7 3 leaf18W1 leaf18Input leaf18S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf18InputNumer i j k) (leaf18W1Numer h) (leaf18S1Numer h j k) 10368 1099511627776 10
    (leaf18S1NumerCorrect h hh j hj k hk)
  norm_num only [show (10368 : ℚ)*1099511627776 = 11399736556781568 by norm_num] at he
  exact he

