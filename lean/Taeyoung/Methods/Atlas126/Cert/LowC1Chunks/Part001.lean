private theorem leaf18S3Correct : Axis3Correct 10 7 3 leaf18W3 leaf18S2 leaf18S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf18S2Numer k j i) (leaf18W3Numer h) (leaf18S3Numer k j h) 6417481163655411345077059977216 8 3
    (leaf18S3NumerCorrect k hk j hj h hh)
  norm_num only [show (6417481163655411345077059977216 : ℚ)*8 = 51339849309243290760616479817728 by norm_num] at he
  exact he

