private theorem leaf18S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf18S3Numer k j h = ∑ i ∈ range 4, leaf18S2Numer k j i * leaf18W3Numer h i := by
