private def leaf24Coeff (i j k : ℕ) : ℚ :=
  (leaf24CoeffNumer i j k : ℚ) / 10368

private theorem leaf24CoeffExpansion (x d u : ℝ) :
    msum leaf24Coeff 10 7 3 x d u = sparseEval (leaf24CoeffTerms.map IntTerm.toRat) x d u / 10368 := by
  have he : ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf24CoeffNumer i j k = intSparseCoeff leaf24CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf24CoeffTerms, t.i ≤ 10 ∧ t.j ≤ 7 ∧ t.k ≤ 3 := by decide +kernel
  exact msum_intSparse_scaled leaf24CoeffNumer leaf24CoeffTerms 10368 10 7 3 he hb x d u

private theorem leaf24Identity (x d u : ℝ) :
    msum leaf24Coeff 10 7 3 x d u = cFace1Target x d u - (0 : ℝ) * cFace1Constraint0 x d u - (0 : ℝ) * cFace1Constraint1 x d u - (0 : ℝ) * cFace1Constraint2 x d u := by
