      0 ≤ trans3 leaf32Coeff 10 7 3 ((5/8) : ℚ) ((5/16) : ℚ) ((345/512) : ℚ) ((15/512) : ℚ) ((1/2) : ℚ) ((1/16) : ℚ) i j k := by
  have exactTable := checked_trans3 leaf32Coeff leaf32S1 leaf32S2 leaf32S3 10 7 3 ((5/8) : ℚ) ((5/16) : ℚ) ((345/512) : ℚ) ((15/512) : ℚ) ((1/2) : ℚ) ((1/16) : ℚ) leaf32W1 leaf32W2 leaf32W3
    leaf32W1Correct leaf32W2Correct leaf32W3Correct
    (axis1Correct_of_table leaf32InputCorrect leaf32S1Correct) leaf32S2Correct leaf32S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf32Signs i hi j hj k hk

