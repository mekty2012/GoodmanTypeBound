    (hx1 : x ≤ (15/16 : ℝ))
    (hd0 : (75/128 : ℝ) ≤ d)
    (hd1 : d ≤ (45/64 : ℝ))
    (hu0 : (5/8 : ℝ) ≤ u)
    (hu1 : u ≤ (3/4 : ℝ)) :
    0 ≤ cFace1Target x d u - (0 : ℝ) * cFace1Constraint0 x d u - (0 : ℝ) * cFace1Constraint1 x d u - (0 : ℝ) * cFace1Constraint2 x d u := by
  have h : 0 ≤ msum leaf34Coeff 10 7 3 x d u :=
    msum_nonneg_on_box leaf34Coeff 10 7 3
      (by norm_num) (by norm_num) (by norm_num)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith) leaf34Certificate
  rwa [leaf34Identity] at h


