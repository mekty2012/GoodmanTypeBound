    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ trans3 leaf34Coeff 10 7 3 ((5/8) : ℚ) ((5/16) : ℚ) ((75/128) : ℚ) ((15/128) : ℚ) ((5/8) : ℚ) ((1/8) : ℚ) i j k := by
