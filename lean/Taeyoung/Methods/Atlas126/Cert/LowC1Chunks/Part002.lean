private def leaf34S3Numer (i j k : ℕ) : ℤ :=
  leaf34S3Data.get ((i * 8 + j) * 4 + k)

private def leaf34S3 (i j k : ℕ) : ℚ :=
  (leaf34S3Numer i j k : ℚ) / 3285750355791570608679454708334592

private theorem leaf34S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf34S3Numer k j h = ∑ i ∈ range 4, leaf34S2Numer k j i * leaf34W3Numer h i := by
  decide +kernel

private theorem leaf34S3Correct : Axis3Correct 10 7 3 leaf34W3 leaf34S2 leaf34S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf34S2Numer k j i) (leaf34W3Numer h) (leaf34S3Numer k j h) 6417481163655411345077059977216 512 3
    (leaf34S3NumerCorrect k hk j hj h hh)
  norm_num only [show (6417481163655411345077059977216 : ℚ)*512 = 3285750355791570608679454708334592 by norm_num] at he
  exact he

private theorem leaf34NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf34S3Numer i j k := by
  decide +kernel

private theorem leaf34Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf34S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf34NumerSigns i hi j hj k hk
  · norm_num


