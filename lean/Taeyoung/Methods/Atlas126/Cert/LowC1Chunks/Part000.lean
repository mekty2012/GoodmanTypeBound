  leaf1S3Data.get ((i * 8 + j) * 4 + k)

private def leaf1S3 (i j k : ℕ) : ℚ :=
  (leaf1S3Numer i j k : ℚ) / 391691965555139852604801024

private theorem leaf1S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf1S3Numer k j h = ∑ i ∈ range 4, leaf1S2Numer k j i * leaf1W3Numer h i := by
  decide +kernel

private theorem leaf1S3Correct : Axis3Correct 10 7 3 leaf1W3 leaf1S2 leaf1S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf1S2Numer k j i) (leaf1W3Numer h) (leaf1S3Numer k j h) 391691965555139852604801024 1 3
    (leaf1S3NumerCorrect k hk j hj h hh)
  norm_num only [show (391691965555139852604801024 : ℚ)*1 = 391691965555139852604801024 by norm_num] at he
  exact he

private theorem leaf1NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf1S3Numer i j k := by
  decide +kernel

private theorem leaf1Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf1S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf1NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf1Certificate :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ trans3 leaf1Coeff 10 7 3 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((15/32) : ℚ) (0 : ℚ) (1 : ℚ) i j k := by
  have exactTable := checked_trans3 leaf1Coeff leaf1S1 leaf1S2 leaf1S3 10 7 3 ((5/8) : ℚ) ((5/16) : ℚ) (0 : ℚ) ((15/32) : ℚ) (0 : ℚ) (1 : ℚ) leaf1W1 leaf1W2 leaf1W3
    leaf1W1Correct leaf1W2Correct leaf1W3Correct
    (axis1Correct_of_table leaf1InputCorrect leaf1S1Correct) leaf1S2Correct leaf1S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf1Signs i hi j hj k hk

