private theorem leaf1CoeffExpansion (x d u : ℝ) :
    msum leaf1Coeff 10 7 3 x d u = sparseEval (leaf1CoeffTerms.map IntTerm.toRat) x d u / 10368 := by
  have he : ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf1CoeffNumer i j k = intSparseCoeff leaf1CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf1CoeffTerms, t.i ≤ 10 ∧ t.j ≤ 7 ∧ t.k ≤ 3 := by decide +kernel
  exact msum_intSparse_scaled leaf1CoeffNumer leaf1CoeffTerms 10368 10 7 3 he hb x d u

