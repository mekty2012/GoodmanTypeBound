private def leaf7S3Numer (i j k : ℕ) : ℤ :=
  leaf7S3Data.get ((i * 8 + j) * 4 + k)

private def leaf7S3 (i j k : ℕ) : ℚ :=
  (leaf7S3Numer i j k : ℚ) / 6571500711583141217358909416669184

private theorem leaf7S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf7S3Numer k j h = ∑ i ∈ range 4, leaf7S2Numer k j i * leaf7W3Numer h i := by
  decide +kernel

private theorem leaf7S3Correct : Axis3Correct 10 7 3 leaf7W3 leaf7S2 leaf7S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf7S2Numer k j i) (leaf7W3Numer h) (leaf7S3Numer k j h) 821437588947892652169863677083648 8 3
    (leaf7S3NumerCorrect k hk j hj h hh)
  norm_num only [show (821437588947892652169863677083648 : ℚ)*8 = 6571500711583141217358909416669184 by norm_num] at he
  exact he

private theorem leaf7NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf7S3Numer i j k := by
