private theorem leaf11S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf11S1Numer h j k = ∑ i ∈ range 11, leaf11InputNumer i j k * leaf11W1Numer h i := by
  decide +kernel

private theorem leaf11S1Correct : Axis1Correct 10 7 3 leaf11W1 leaf11Input leaf11S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf11InputNumer i j k) (leaf11W1Numer h) (leaf11S1Numer h j k) 113705856 1099511627776 10
    (leaf11S1NumerCorrect h hh j hj k hk)
  norm_num only [show (113705856 : ℚ)*1099511627776 = 125020910818223456256 by norm_num] at he
  exact he

