private theorem leaf1S2NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf1S2Numer k j h = ∑ i ∈ range 8, leaf1S1Numer k i h * leaf1W2Numer j i := by
  decide +kernel

