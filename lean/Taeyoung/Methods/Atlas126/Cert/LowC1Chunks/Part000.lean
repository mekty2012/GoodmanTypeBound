  intro k hk i hi
  have he := intTransWeight_cast 10 (10) 5 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf11W1NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^10 = 1099511627776 by norm_num,
    show (10 : ℚ)/16 = (5/8) by norm_num,
    show (5 : ℚ)/16 = (5/16) by norm_num] at he
  simpa only [leaf11W1, neg_div] using he

