  leaf14S1Data.get ((i * 8 + j) * 4 + k)

private def leaf14S1 (i j k : ℕ) : ℚ :=
  (leaf14S1Numer i j k : ℚ) / 71806940571167096832

private theorem leaf14S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf14S1Numer h j k = ∑ i ∈ range 11, leaf14InputNumer i j k * leaf14W1Numer h i := by
  decide +kernel

private theorem leaf14S1Correct : Axis1Correct 10 7 3 leaf14W1 leaf14Input leaf14S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf14InputNumer i j k) (leaf14W1Numer h) (leaf14S1Numer h j k) 65308032 1099511627776 10
    (leaf14S1NumerCorrect h hh j hj k hk)
  norm_num only [show (65308032 : ℚ)*1099511627776 = 71806940571167096832 by norm_num] at he
  exact he

