    ∀ h ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      leaf8S1Numer h j k = ∑ i ∈ range 11, leaf8InputNumer i j k * leaf8W1Numer h i := by
  decide +kernel

private theorem leaf8S1Correct : Axis1Correct 10 6 3 leaf8W1 leaf8Input leaf8S1 := by
  intro h hh j hj k hk
