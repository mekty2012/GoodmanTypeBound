  leaf10S1Data.get ((i * 7 + j) * 4 + k)

private def leaf10S1 (i j k : ℕ) : ℚ :=
  (leaf10S1Numer i j k : ℚ) / 729583139634020352

private theorem leaf10S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      leaf10S1Numer h j k = ∑ i ∈ range 11, leaf10InputNumer i j k * leaf10W1Numer h i := by
  decide +kernel

private theorem leaf10S1Correct : Axis1Correct 10 6 3 leaf10W1 leaf10Input leaf10S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf10InputNumer i j k) (leaf10W1Numer h) (leaf10S1Numer h j k) 648 1125899906842624 10
    (leaf10S1NumerCorrect h hh j hj k hk)
  norm_num only [show (648 : ℚ)*1125899906842624 = 729583139634020352 by norm_num] at he
  exact he

