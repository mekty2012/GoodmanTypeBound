private def leaf16S3Numer (i j k : ℕ) : ℤ :=
  leaf16S3Data.get ((i * 7 + j) * 4 + k)

private def leaf16S3 (i j k : ℕ) : ℚ :=
  (leaf16S3Numer i j k : ℚ) / 410718794473946326084931838541824

private theorem leaf16S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 7, ∀ h ∈ range 4,
      leaf16S3Numer k j h = ∑ i ∈ range 4, leaf16S2Numer k j i * leaf16W3Numer h i := by
  decide +kernel

private theorem leaf16S3Correct : Axis3Correct 10 6 3 leaf16W3 leaf16S2 leaf16S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf16S2Numer k j i) (leaf16W3Numer h) (leaf16S3Numer k j h) 51339849309243290760616479817728 8 3
    (leaf16S3NumerCorrect k hk j hj h hh)
  norm_num only [show (51339849309243290760616479817728 : ℚ)*8 = 410718794473946326084931838541824 by norm_num] at he
  exact he

private theorem leaf16NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ leaf16S3Numer i j k := by
  decide +kernel

private theorem leaf16Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ leaf16S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf16NumerSigns i hi j hj k hk
  · norm_num


