private theorem leaf19S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 7, ∀ h ∈ range 4,
      leaf19S3Numer k j h = ∑ i ∈ range 4, leaf19S2Numer k j i * leaf19W3Numer h i := by
