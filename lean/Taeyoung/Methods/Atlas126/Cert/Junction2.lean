    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ trans3 (cmb (2011/17706 : ℚ)) 10 6 3 ((15/16) : ℚ) ((1/64) : ℚ) ((15/64) : ℚ) ((15/64) : ℚ) (0 : ℚ) ((1/2) : ℚ) i j k := by
  have exactTable := checked_trans3 (cmb (2011/17706 : ℚ)) leaf6S1 leaf6S2 leaf6S3 10 6 3 ((15/16) : ℚ) ((1/64) : ℚ) ((15/64) : ℚ) ((15/64) : ℚ) (0 : ℚ) ((1/2) : ℚ) leaf6W1 leaf6W2 leaf6W3
    leaf6W1Correct leaf6W2Correct leaf6W3Correct
