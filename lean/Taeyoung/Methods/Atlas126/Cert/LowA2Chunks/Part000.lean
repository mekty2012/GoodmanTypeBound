    (hx0 : (0 : ℝ) ≤ x)
    (hx1 : x ≤ (5/8 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (15/64 : ℝ))
    (hu0 : (0 : ℝ) ≤ u)
