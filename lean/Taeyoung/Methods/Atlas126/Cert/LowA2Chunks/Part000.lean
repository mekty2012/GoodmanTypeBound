private theorem leaf4S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 7, ∀ h ∈ range 4,
      leaf4S3Numer k j h = ∑ i ∈ range 4, leaf4S2Numer k j i * leaf4W3Numer h i := by
