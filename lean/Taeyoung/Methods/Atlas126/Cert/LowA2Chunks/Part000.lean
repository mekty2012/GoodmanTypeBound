private def leaf2S3Numer (i j k : ℕ) : ℤ :=
  leaf2S3Data.get ((i * 7 + j) * 4 + k)

private def leaf2S3 (i j k : ℕ) : ℚ :=
  (leaf2S3Numer i j k : ℚ) / 9562792127811031557734400

private theorem leaf2S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 7, ∀ h ∈ range 4,
      leaf2S3Numer k j h = ∑ i ∈ range 4, leaf2S2Numer k j i * leaf2W3Numer h i := by
  decide +kernel

private theorem leaf2S3Correct : Axis3Correct 10 6 3 leaf2W3 leaf2S2 leaf2S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf2S2Numer k j i) (leaf2W3Numer h) (leaf2S3Numer k j h) 9562792127811031557734400 1 3
    (leaf2S3NumerCorrect k hk j hj h hh)
  norm_num only [show (9562792127811031557734400 : ℚ)*1 = 9562792127811031557734400 by norm_num] at he
  exact he

private theorem leaf2NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ leaf2S3Numer i j k := by
  decide +kernel

private theorem leaf2Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ leaf2S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf2NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf2Certificate :
    ∀ i ∈ range 11, ∀ j ∈ range 7, ∀ k ∈ range 4,
      0 ≤ trans3 leaf2Coeff 10 6 3 (0 : ℚ) ((5/8) : ℚ) (0 : ℚ) ((15/64) : ℚ) (0 : ℚ) (1 : ℚ) i j k := by
  have exactTable := checked_trans3 leaf2Coeff leaf2S1 leaf2S2 leaf2S3 10 6 3 (0 : ℚ) ((5/8) : ℚ) (0 : ℚ) ((15/64) : ℚ) (0 : ℚ) (1 : ℚ) leaf2W1 leaf2W2 leaf2W3
    leaf2W1Correct leaf2W2Correct leaf2W3Correct
    (axis1Correct_of_table leaf2InputCorrect leaf2S1Correct) leaf2S2Correct leaf2S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf2Signs i hi j hj k hk

