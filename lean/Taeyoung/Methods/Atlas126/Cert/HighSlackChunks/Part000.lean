private def leaf6S2Numer (i j k : ℕ) : ℤ :=
  leaf6S2Data.get ((i * 4 + j) * 8 + k)

private def leaf6S2 (i j k : ℕ) : ℚ :=
  (leaf6S2Numer i j k : ℚ) / 1019215872

private theorem leaf6S2NumerCorrect :
    ∀ k ∈ range 9, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf6S2Numer k j h = ∑ i ∈ range 4, leaf6S1Numer k i h * leaf6W2Numer j i := by
  decide +kernel

private theorem leaf6S2Correct : Axis2Correct 8 3 7 leaf6W2 leaf6S1 leaf6S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf6S1Numer k i h) (leaf6W2Numer j) (leaf6S2Numer k j h) 15925248 64 3
    (leaf6S2NumerCorrect k hk j hj h hh)
  norm_num only [show (15925248 : ℚ)*64 = 1019215872 by norm_num] at he
  exact he

