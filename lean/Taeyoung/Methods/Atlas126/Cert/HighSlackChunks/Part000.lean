private theorem leaf1S3NumerCorrect :
    ∀ k ∈ range 9, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf1S3Numer k j h = ∑ i ∈ range 8, leaf1S2Numer k j i * leaf1W3Numer h i := by
  decide +kernel

private theorem leaf1S3Correct : Axis3Correct 8 3 7 leaf1W3 leaf1S2 leaf1S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf1S2Numer k j i) (leaf1W3Numer h) (leaf1S3Numer k j h) 15552 128 7
    (leaf1S3NumerCorrect k hk j hj h hh)
  norm_num only [show (15552 : ℚ)*128 = 1990656 by norm_num] at he
  exact he

