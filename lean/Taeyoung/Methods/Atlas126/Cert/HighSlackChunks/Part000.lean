private def leaf3S1Numer (i j k : ℕ) : ℤ :=
  leaf3S1Data.get ((i * 4 + j) * 8 + k)

private def leaf3S1 (i j k : ℕ) : ℚ :=
  (leaf3S1Numer i j k : ℚ) / 62208

private theorem leaf3S1NumerCorrect :
    ∀ h ∈ range 9, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf3S1Numer h j k = ∑ i ∈ range 9, commonInputNumer i j k * leaf3W1Numer h i := by
  decide +kernel

private theorem leaf3S1Correct : Axis1Correct 8 3 7 leaf3W1 commonInput leaf3S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => commonInputNumer i j k) (leaf3W1Numer h) (leaf3S1Numer h j k) 243 256 8
    (leaf3S1NumerCorrect h hh j hj k hk)
  norm_num only [show (243 : ℚ)*256 = 62208 by norm_num] at he
  exact he

