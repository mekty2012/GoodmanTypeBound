private def leaf5S3Numer (i j k : ℕ) : ℤ :=
  leaf5S3Data.get ((i * 4 + j) * 8 + k)

private def leaf5S3 (i j k : ℕ) : ℚ :=
  (leaf5S3Numer i j k : ℚ) / 130459631616

private theorem leaf5S3NumerCorrect :
    ∀ k ∈ range 9, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf5S3Numer k j h = ∑ i ∈ range 8, leaf5S2Numer k j i * leaf5W3Numer h i := by
  decide +kernel

private theorem leaf5S3Correct : Axis3Correct 8 3 7 leaf5W3 leaf5S2 leaf5S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf5S2Numer k j i) (leaf5W3Numer h) (leaf5S3Numer k j h) 1019215872 128 7
    (leaf5S3NumerCorrect k hk j hj h hh)
  norm_num only [show (1019215872 : ℚ)*128 = 130459631616 by norm_num] at he
  exact he

private theorem leaf5NumerSigns :
    ∀ i ∈ range 9, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf5S3Numer i j k := by
  decide +kernel

private theorem leaf5Signs :
    ∀ i ∈ range 9, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf5S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf5NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf5Certificate :
    ∀ i ∈ range 9, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ trans3 commonCoeff 8 3 7 ((1/2) : ℚ) ((1/4) : ℚ) (0 : ℚ) ((1/4) : ℚ) ((1/2) : ℚ) ((1/2) : ℚ) i j k := by
  have exactTable := checked_trans3 commonCoeff leaf5S1 leaf5S2 leaf5S3 8 3 7 ((1/2) : ℚ) ((1/4) : ℚ) (0 : ℚ) ((1/4) : ℚ) ((1/2) : ℚ) ((1/2) : ℚ) leaf5W1 leaf5W2 leaf5W3
    leaf5W1Correct leaf5W2Correct leaf5W3Correct
    (axis1Correct_of_table commonInputCorrect leaf5S1Correct) leaf5S2Correct leaf5S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf5Signs i hi j hj k hk

theorem leaf5 {x d u : ℝ}
    (hx0 : (1/2 : ℝ) ≤ x)
    (hx1 : x ≤ (3/4 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (1/4 : ℝ))
    (hu0 : (1/2 : ℝ) ≤ u)
    (hu1 : u ≤ (1 : ℝ)) : 0 ≤ highScaledSlackTarget x d u := by
  have hb := msum_nonneg_on_box commonCoeff 8 3 7 (x := x) (y := d) (z := u)
    (by norm_num) (by norm_num) (by norm_num)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) leaf5Certificate
  rwa [commonIdentity] at hb


