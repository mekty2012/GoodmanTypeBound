private def leaf1S1 (i j k : ℕ) : ℚ :=
  (leaf1S1Numer i j k : ℚ) / 243

private theorem leaf1S1NumerCorrect :
    ∀ h ∈ range 9, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf1S1Numer h j k = ∑ i ∈ range 9, commonInputNumer i j k * leaf1W1Numer h i := by
  decide +kernel

private theorem leaf1S1Correct : Axis1Correct 8 3 7 leaf1W1 commonInput leaf1S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => commonInputNumer i j k) (leaf1W1Numer h) (leaf1S1Numer h j k) 243 1 8
    (leaf1S1NumerCorrect h hh j hj k hk)
  norm_num only [show (243 : ℚ)*1 = 243 by norm_num] at he
  exact he

