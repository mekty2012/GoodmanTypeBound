private def leaf5W1Numer (k i : ℕ) : ℤ :=
  leaf5W1Data.get (k * 9 + i)

private def leaf5W1 (k i : ℕ) : ℚ :=
  (leaf5W1Numer k i : ℚ) / 65536

private theorem leaf5W1NumerCorrect :
    ∀ k ∈ range 9, ∀ i ∈ range 9,
      leaf5W1Numer k i = intTransWeight 8 (2) 1 4 k i := by
  decide +kernel

private theorem leaf5W1Correct : WeightsCorrect 8 ((1/2) : ℚ) ((1/4) : ℚ) leaf5W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 8 (2) 1 4 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf5W1NumerCorrect k hk i hi] at he
  norm_num only [show (4 : ℚ)^8 = 65536 by norm_num,
    show (2 : ℚ)/4 = (1/2) by norm_num,
    show (1 : ℚ)/4 = (1/4) by norm_num] at he
  simpa only [leaf5W1, neg_div] using he

