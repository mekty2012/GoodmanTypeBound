private def leaf10InputNumer (i j k : ℕ) : ℤ :=
  leaf10InputData.get ((i * 4 + j) * 8 + k)

private def leaf10Input (i j k : ℕ) : ℚ :=
  (leaf10InputNumer i j k : ℚ) / 839808

private theorem leaf10InputNumerCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf10InputNumer i j k = leaf10CoeffNumer i j k := by
  decide +kernel

private theorem leaf10InputCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf10Input i j k = leaf10Coeff i j k := by
  intro i hi j hj k hk
  exact congrArg (fun v : ℤ => (v : ℚ)/839808)
    (leaf10InputNumerCorrect i hi j hj k hk)

