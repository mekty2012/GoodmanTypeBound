private def leaf9CoeffNumer (i j k : ℕ) : ℤ :=
  intSparseCoeff leaf9CoeffTerms i j k

private def leaf9Coeff (i j k : ℕ) : ℚ :=
  (leaf9CoeffNumer i j k : ℚ) / 839808

private theorem leaf9CoeffExpansion (x d u : ℝ) :
    msum leaf9Coeff 22 3 7 x d u = sparseEval (leaf9CoeffTerms.map IntTerm.toRat) x d u / 839808 := by
  have he : ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf9CoeffNumer i j k = intSparseCoeff leaf9CoeffTerms i j k := by intros; rfl
  have hb : ∀ t ∈ leaf9CoeffTerms, t.i ≤ 22 ∧ t.j ≤ 3 ∧ t.k ≤ 7 := by decide +kernel
  exact msum_intSparse_scaled leaf9CoeffNumer leaf9CoeffTerms 839808 22 3 7 he hb x d u

private theorem leaf9Identity (x d u : ℝ) :
    msum leaf9Coeff 22 3 7 x d u = junctionSlackTarget x d u := by
  rw [leaf9CoeffExpansion]
  simp only [sparseEval, IntTerm.toRat, leaf9CoeffTerms, junctionSlackTarget, slackPolynomial, scalarResidual, betaJ, gammaJ, lambdaJ, betaHigh, gammaHigh, lowDensity, lowTriangle, target, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  push_cast
  ring

