private theorem leaf10W1NumerCorrect :
    ∀ k ∈ range 23, ∀ i ∈ range 23,
      leaf10W1Numer k i = intTransWeight 22 (0) 1 16 k i := by
  decide +kernel

private theorem leaf10W1Correct : WeightsCorrect 22 (0 : ℚ) ((1/16) : ℚ) leaf10W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 22 (0) 1 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf10W1NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^22 = 309485009821345068724781056 by norm_num,
    show (0 : ℚ)/16 = 0 by norm_num,
    show (1 : ℚ)/16 = (1/16) by norm_num] at he
  simpa only [leaf10W1, neg_div] using he

