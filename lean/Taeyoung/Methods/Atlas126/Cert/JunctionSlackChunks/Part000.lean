private theorem leaf3S1NumerCorrect :
    ∀ h ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf3S1Numer h j k = ∑ i ∈ range 23, leaf3InputNumer i j k * leaf3W1Numer h i := by
  decide +kernel

private theorem leaf3S1Correct : Axis1Correct 22 3 7 leaf3W1 leaf3Input leaf3S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf3InputNumer i j k) (leaf3W1Numer h) (leaf3S1Numer h j k) 839808 309485009821345068724781056 22
    (leaf3S1NumerCorrect h hh j hj k hk)
  norm_num only [show (839808 : ℚ)*309485009821345068724781056 = 259907987128044159475620929077248 by norm_num] at he
  exact he

