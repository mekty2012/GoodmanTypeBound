private def leaf4InputNumer (i j k : ℕ) : ℤ :=
  leaf4InputData.get ((i * 4 + j) * 8 + k)

private def leaf4Input (i j k : ℕ) : ℚ :=
  (leaf4InputNumer i j k : ℚ) / 839808

private theorem leaf4InputNumerCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf4InputNumer i j k = leaf4CoeffNumer i j k := by
  decide +kernel

private theorem leaf4InputCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf4Input i j k = leaf4Coeff i j k := by
  intro i hi j hj k hk
  exact congrArg (fun v : ℤ => (v : ℚ)/839808)
    (leaf4InputNumerCorrect i hi j hj k hk)

