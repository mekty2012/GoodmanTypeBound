private def leaf8InputNumer (i j k : ℕ) : ℤ :=
  leaf8InputData.get ((i * 4 + j) * 8 + k)

private def leaf8Input (i j k : ℕ) : ℚ :=
  (leaf8InputNumer i j k : ℚ) / 839808

private theorem leaf8InputNumerCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf8InputNumer i j k = leaf8CoeffNumer i j k := by
  decide +kernel

private theorem leaf8InputCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf8Input i j k = leaf8Coeff i j k := by
  intro i hi j hj k hk
  exact congrArg (fun v : ℤ => (v : ℚ)/839808)
    (leaf8InputNumerCorrect i hi j hj k hk)

