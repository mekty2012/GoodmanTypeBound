private def leaf7S3Numer (i j k : ℕ) : ℤ :=
  leaf7S3Data.get ((i * 4 + j) * 8 + k)

private def leaf7S3 (i j k : ℕ) : ℚ :=
  (leaf7S3Numer i j k : ℚ) / 198676759305355727740839035978188106760192

private theorem leaf7S3NumerCorrect :
    ∀ k ∈ range 23, ∀ j ∈ range 4, ∀ h ∈ range 8,
      leaf7S3Numer k j h = ∑ i ∈ range 8, leaf7S2Numer k j i * leaf7W3Numer h i := by
  decide +kernel

private theorem leaf7S3Correct : Axis3Correct 22 3 7 leaf7W3 leaf7S2 leaf7S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf7S2Numer k j i) (leaf7W3Numer h) (leaf7S3Numer k j h) 12126267047446028304494570067028082688 16384 7
    (leaf7S3NumerCorrect k hk j hj h hh)
  norm_num only [show (12126267047446028304494570067028082688 : ℚ)*16384 = 198676759305355727740839035978188106760192 by norm_num] at he
  exact he

private theorem leaf7NumerSigns :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf7S3Numer i j k := by
  decide +kernel

private theorem leaf7Signs :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      0 ≤ leaf7S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf7NumerSigns i hi j hj k hk
  · norm_num


