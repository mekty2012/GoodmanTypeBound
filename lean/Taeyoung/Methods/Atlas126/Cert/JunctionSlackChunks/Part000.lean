private def leaf8W3Numer (k i : ℕ) : ℤ :=
  leaf8W3Data.get (k * 8 + i)

private def leaf8W3 (k i : ℕ) : ℚ :=
  (leaf8W3Numer k i : ℚ) / 16384

private theorem leaf8W3NumerCorrect :
    ∀ k ∈ range 8, ∀ i ∈ range 8,
      leaf8W3Numer k i = intTransWeight 7 (1) 1 4 k i := by
  decide +kernel

private theorem leaf8W3Correct : WeightsCorrect 7 ((1/4) : ℚ) ((1/4) : ℚ) leaf8W3 := by
  intro k hk i hi
  have he := intTransWeight_cast 7 (1) 1 4 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf8W3NumerCorrect k hk i hi] at he
  norm_num only [show (4 : ℚ)^7 = 16384 by norm_num,
    show (1 : ℚ)/4 = (1/4) by norm_num,
    show (1 : ℚ)/4 = (1/4) by norm_num] at he
  simpa only [leaf8W3, neg_div] using he

