  leaf8W1Data.get (k * 23 + i)

private def leaf8W1 (k i : ℕ) : ℚ :=
  (leaf8W1Numer k i : ℚ) / 309485009821345068724781056

private theorem leaf8W1NumerCorrect :
    ∀ k ∈ range 23, ∀ i ∈ range 23,
      leaf8W1Numer k i = intTransWeight 22 (0) 1 16 k i := by
  decide +kernel

private theorem leaf8W1Correct : WeightsCorrect 22 (0 : ℚ) ((1/16) : ℚ) leaf8W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 22 (0) 1 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf8W1NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^22 = 309485009821345068724781056 by norm_num,
    show (0 : ℚ)/16 = 0 by norm_num,
    show (1 : ℚ)/16 = (1/16) by norm_num] at he
  simpa only [leaf8W1, neg_div] using he

