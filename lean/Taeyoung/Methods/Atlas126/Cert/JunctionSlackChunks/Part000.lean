private def leaf7InputNumer (i j k : ℕ) : ℤ :=
  leaf7InputData.get ((i * 4 + j) * 8 + k)

private def leaf7Input (i j k : ℕ) : ℚ :=
  (leaf7InputNumer i j k : ℚ) / 839808

private theorem leaf7InputNumerCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf7InputNumer i j k = leaf7CoeffNumer i j k := by
  decide +kernel

private theorem leaf7InputCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf7Input i j k = leaf7Coeff i j k := by
  intro i hi j hj k hk
  exact congrArg (fun v : ℤ => (v : ℚ)/839808)
    (leaf7InputNumerCorrect i hi j hj k hk)

