  leaf3InputData.get ((i * 4 + j) * 8 + k)

private def leaf3Input (i j k : ℕ) : ℚ :=
  (leaf3InputNumer i j k : ℚ) / 839808

private theorem leaf3InputNumerCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf3InputNumer i j k = leaf3CoeffNumer i j k := by
  decide +kernel

private theorem leaf3InputCorrect :
    ∀ i ∈ range 23, ∀ j ∈ range 4, ∀ k ∈ range 8,
      leaf3Input i j k = leaf3Coeff i j k := by
  intro i hi j hj k hk
  exact congrArg (fun v : ℤ => (v : ℚ)/839808)
    (leaf3InputNumerCorrect i hi j hj k hk)

