private def leaf2S1Numer (i j k : ℕ) : ℤ :=
  leaf2S1Data.get ((i * 8 + j) * 4 + k)

private def leaf2S1 (i j k : ℕ) : ℚ :=
  (leaf2S1Numer i j k : ℚ) / 1424967069597696

private theorem leaf2S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf2S1Numer h j k = ∑ i ∈ range 11, leaf2InputNumer i j k * leaf2W1Numer h i := by
  decide +kernel

private theorem leaf2S1Correct : Axis1Correct 10 7 3 leaf2W1 leaf2Input leaf2S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf2InputNumer i j k) (leaf2W1Numer h) (leaf2S1Numer h j k) 1296 1099511627776 10
    (leaf2S1NumerCorrect h hh j hj k hk)
  norm_num only [show (1296 : ℚ)*1099511627776 = 1424967069597696 by norm_num] at he
  exact he

