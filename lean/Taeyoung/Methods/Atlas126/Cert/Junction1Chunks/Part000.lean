private theorem leaf2S2NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf2S2Numer k j h = ∑ i ∈ range 8, leaf2S1Numer k i h * leaf2W2Numer j i := by
  decide +kernel

private theorem leaf2S2Correct : Axis2Correct 10 7 3 leaf2W2 leaf2S1 leaf2S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf2S1Numer k i h) (leaf2W2Numer j) (leaf2S2Numer k j h) 1424967069597696 34359738368 7
    (leaf2S2NumerCorrect k hk j hj h hh)
  norm_num only [show (1424967069597696 : ℚ)*34359738368 = 48961495694392481575600128 by norm_num] at he
  exact he

