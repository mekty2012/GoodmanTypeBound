private theorem leaf10S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf10S1Numer h j k = ∑ i ∈ range 11, leaf10InputNumer i j k * leaf10W1Numer h i := by
  decide +kernel

private theorem leaf10S1Correct : Axis1Correct 10 7 3 leaf10W1 leaf10Input leaf10S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf10InputNumer i j k) (leaf10W1Numer h) (leaf10S1Numer h j k) 1296 1099511627776 10
    (leaf10S1NumerCorrect h hh j hj k hk)
  norm_num only [show (1296 : ℚ)*1099511627776 = 1424967069597696 by norm_num] at he
  exact he

