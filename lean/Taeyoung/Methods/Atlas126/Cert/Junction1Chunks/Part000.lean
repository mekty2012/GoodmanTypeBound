private def leaf2S3Numer (i j k : ℕ) : ℤ :=
  leaf2S3Data.get ((i * 8 + j) * 4 + k)

private def leaf2S3 (i j k : ℕ) : ℚ :=
  (leaf2S3Numer i j k : ℚ) / 391691965555139852604801024

private theorem leaf2S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf2S3Numer k j h = ∑ i ∈ range 4, leaf2S2Numer k j i * leaf2W3Numer h i := by
  decide +kernel

private theorem leaf2S3Correct : Axis3Correct 10 7 3 leaf2W3 leaf2S2 leaf2S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf2S2Numer k j i) (leaf2W3Numer h) (leaf2S3Numer k j h) 48961495694392481575600128 8 3
    (leaf2S3NumerCorrect k hk j hj h hh)
  norm_num only [show (48961495694392481575600128 : ℚ)*8 = 391691965555139852604801024 by norm_num] at he
  exact he

private theorem leaf2NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf2S3Numer i j k := by
  decide +kernel

private theorem leaf2Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf2S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf2NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf2Certificate :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ trans3 leaf2Coeff 10 7 3 ((15/16) : ℚ) ((1/16) : ℚ) (0 : ℚ) ((15/32) : ℚ) (0 : ℚ) ((1/2) : ℚ) i j k := by
  have exactTable := checked_trans3 leaf2Coeff leaf2S1 leaf2S2 leaf2S3 10 7 3 ((15/16) : ℚ) ((1/16) : ℚ) (0 : ℚ) ((15/32) : ℚ) (0 : ℚ) ((1/2) : ℚ) leaf2W1 leaf2W2 leaf2W3
    leaf2W1Correct leaf2W2Correct leaf2W3Correct
    (axis1Correct_of_table leaf2InputCorrect leaf2S1Correct) leaf2S2Correct leaf2S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf2Signs i hi j hj k hk

theorem leaf2 {x d u : ℝ}
    (hx0 : (15/16 : ℝ) ≤ x)
    (hx1 : x ≤ (1 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (15/32 : ℝ))
    (hu0 : (0 : ℝ) ≤ u)
    (hu1 : u ≤ (1/2 : ℝ)) :
    0 ≤ junctionFace1Target x d u - (0 : ℝ) * junctionFace1Constraint0 x d u - (0 : ℝ) * junctionFace1Constraint1 x d u := by
  have h : 0 ≤ msum leaf2Coeff 10 7 3 x d u :=
    msum_nonneg_on_box leaf2Coeff 10 7 3
      (by norm_num) (by norm_num) (by norm_num)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith) leaf2Certificate
  rwa [leaf2Identity] at h


