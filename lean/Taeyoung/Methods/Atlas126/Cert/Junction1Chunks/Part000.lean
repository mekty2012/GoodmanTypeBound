private theorem leaf12S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf12S1Numer h j k = ∑ i ∈ range 11, leaf12InputNumer i j k * leaf12W1Numer h i := by
  decide +kernel

private theorem leaf12S1Correct : Axis1Correct 10 7 3 leaf12W1 leaf12Input leaf12S1 := by
  intro h hh j hj k hk
