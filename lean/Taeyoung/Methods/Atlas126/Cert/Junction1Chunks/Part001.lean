private def leaf37S3Numer (i j k : ℕ) : ℤ :=
  leaf37S3Data.get ((i * 8 + j) * 4 + k)

private def leaf37S3 (i j k : ℕ) : ℚ :=
  (leaf37S3Numer i j k : ℚ) / 420576045541321037910970202666827776

private theorem leaf37S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf37S3Numer k j h = ∑ i ∈ range 4, leaf37S2Numer k j i * leaf37W3Numer h i := by
  decide +kernel

private theorem leaf37S3Correct : Axis3Correct 10 7 3 leaf37W3 leaf37S2 leaf37S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf37S2Numer k j i) (leaf37W3Numer h) (leaf37S3Numer k j h) 102679698618486581521232959635456 4096 3
    (leaf37S3NumerCorrect k hk j hj h hh)
  norm_num only [show (102679698618486581521232959635456 : ℚ)*4096 = 420576045541321037910970202666827776 by norm_num] at he
  exact he

private theorem leaf37NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf37S3Numer i j k := by
  decide +kernel

private theorem leaf37Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf37S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf37NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf37Certificate :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ trans3 leaf37Coeff 10 7 3 ((15/16) : ℚ) ((1/16) : ℚ) ((75/128) : ℚ) ((15/256) : ℚ) ((1/2) : ℚ) ((1/16) : ℚ) i j k := by
  have exactTable := checked_trans3 leaf37Coeff leaf37S1 leaf37S2 leaf37S3 10 7 3 ((15/16) : ℚ) ((1/16) : ℚ) ((75/128) : ℚ) ((15/256) : ℚ) ((1/2) : ℚ) ((1/16) : ℚ) leaf37W1 leaf37W2 leaf37W3
    leaf37W1Correct leaf37W2Correct leaf37W3Correct
    (axis1Correct_of_table leaf37InputCorrect leaf37S1Correct) leaf37S2Correct leaf37S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf37Signs i hi j hj k hk

theorem leaf37 {x d u : ℝ}
    (hx0 : (15/16 : ℝ) ≤ x)
    (hx1 : x ≤ (1 : ℝ))
    (hd0 : (75/128 : ℝ) ≤ d)
    (hd1 : d ≤ (165/256 : ℝ))
    (hu0 : (1/2 : ℝ) ≤ u)
    (hu1 : u ≤ (9/16 : ℝ)) :
    0 ≤ junctionFace1Target x d u - (0 : ℝ) * junctionFace1Constraint0 x d u - (0 : ℝ) * junctionFace1Constraint1 x d u := by
  have h : 0 ≤ msum leaf37Coeff 10 7 3 x d u :=
    msum_nonneg_on_box leaf37Coeff 10 7 3
      (by norm_num) (by norm_num) (by norm_num)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith) leaf37Certificate
  rwa [leaf37Identity] at h


