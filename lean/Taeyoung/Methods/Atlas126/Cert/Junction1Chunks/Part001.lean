    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf23S1Numer h j k = ∑ i ∈ range 11, leaf23InputNumer i j k * leaf23W1Numer h i := by
  decide +kernel

