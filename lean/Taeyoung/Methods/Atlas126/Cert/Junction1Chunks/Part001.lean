private def leaf29S3Numer (i j k : ℕ) : ℤ :=
  leaf29S3Data.get ((i * 8 + j) * 4 + k)

private def leaf29S3 (i j k : ℕ) : ℚ :=
  (leaf29S3Numer i j k : ℚ) / 391691965555139852604801024

private theorem leaf29S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf29S3Numer k j h = ∑ i ∈ range 4, leaf29S2Numer k j i * leaf29W3Numer h i := by
  decide +kernel

private theorem leaf29S3Correct : Axis3Correct 10 7 3 leaf29W3 leaf29S2 leaf29S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf29S2Numer k j i) (leaf29W3Numer h) (leaf29S3Numer k j h) 48961495694392481575600128 8 3
    (leaf29S3NumerCorrect k hk j hj h hh)
  norm_num only [show (48961495694392481575600128 : ℚ)*8 = 391691965555139852604801024 by norm_num] at he
  exact he

private theorem leaf29NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf29S3Numer i j k := by
  decide +kernel

private theorem leaf29Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf29S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf29NumerSigns i hi j hj k hk
  · norm_num


