theorem leaf29 {x d u : ℝ}
    (hx0 : (15/16 : ℝ) ≤ x)
    (hx1 : x ≤ (1 : ℝ))
    (hd0 : (0 : ℝ) ≤ d)
    (hd1 : d ≤ (15/32 : ℝ))
    (hu0 : (1/2 : ℝ) ≤ u)
    (hu1 : u ≤ (1 : ℝ)) :
    0 ≤ junctionFace1Target x d u - (0 : ℝ) * junctionFace1Constraint0 x d u - (0 : ℝ) * junctionFace1Constraint1 x d u := by
  have h : 0 ≤ msum leaf29Coeff 10 7 3 x d u :=
    msum_nonneg_on_box leaf29Coeff 10 7 3
