  leaf25S1Data.get ((i * 8 + j) * 4 + k)

private def leaf25S1 (i j k : ℕ) : ℚ :=
  (leaf25S1Numer i j k : ℚ) / 1424967069597696

private theorem leaf25S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf25S1Numer h j k = ∑ i ∈ range 11, leaf25InputNumer i j k * leaf25W1Numer h i := by
  decide +kernel

private theorem leaf25S1Correct : Axis1Correct 10 7 3 leaf25W1 leaf25Input leaf25S1 := by
  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf25InputNumer i j k) (leaf25W1Numer h) (leaf25S1Numer h j k) 1296 1099511627776 10
    (leaf25S1NumerCorrect h hh j hj k hk)
  norm_num only [show (1296 : ℚ)*1099511627776 = 1424967069597696 by norm_num] at he
  exact he

