  (leaf22W1Numer k i : ℚ) / 1099511627776

private theorem leaf22W1NumerCorrect :
    ∀ k ∈ range 11, ∀ i ∈ range 11,
      leaf22W1Numer k i = intTransWeight 10 (15) 1 16 k i := by
  decide +kernel

private theorem leaf22W1Correct : WeightsCorrect 10 ((15/16) : ℚ) ((1/16) : ℚ) leaf22W1 := by
  intro k hk i hi
  have he := intTransWeight_cast 10 (15) 1 16 k i
    (by simp only [mem_range] at hi; omega) (by norm_num)
  rw [← leaf22W1NumerCorrect k hk i hi] at he
  norm_num only [show (16 : ℚ)^10 = 1099511627776 by norm_num,
    show (15 : ℚ)/16 = (15/16) by norm_num,
    show (1 : ℚ)/16 = (1/16) by norm_num] at he
  simpa only [leaf22W1, neg_div] using he

