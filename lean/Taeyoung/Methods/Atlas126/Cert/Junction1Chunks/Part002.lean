private theorem leaf46S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf46S1Numer h j k = ∑ i ∈ range 11, leaf46InputNumer i j k * leaf46W1Numer h i := by
  decide +kernel

private theorem leaf46S1Correct : Axis1Correct 10 7 3 leaf46W1 leaf46Input leaf46S1 := by
  intro h hh j hj k hk
