private def leaf43S3Numer (i j k : ℕ) : ℤ :=
  leaf43S3Data.get ((i * 8 + j) * 4 + k)

private def leaf43S3 (i j k : ℕ) : ℚ :=
  (leaf43S3Numer i j k : ℚ) / 401092572728463209067316248576

private theorem leaf43S3NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf43S3Numer k j h = ∑ i ∈ range 4, leaf43S2Numer k j i * leaf43W3Numer h i := by
  decide +kernel

private theorem leaf43S3Correct : Axis3Correct 10 7 3 leaf43W3 leaf43S2 leaf43S3 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf43S2Numer k j i) (leaf43W3Numer h) (leaf43S3Numer k j h) 6267071448882237641676816384 64 3
    (leaf43S3NumerCorrect k hk j hj h hh)
  norm_num only [show (6267071448882237641676816384 : ℚ)*64 = 401092572728463209067316248576 by norm_num] at he
  exact he

private theorem leaf43NumerSigns :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf43S3Numer i j k := by
  decide +kernel

private theorem leaf43Signs :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ leaf43S3 i j k := by
  intro i hi j hj k hk
  apply div_nonneg
  · exact_mod_cast leaf43NumerSigns i hi j hj k hk
  · norm_num


private theorem leaf43Certificate :
    ∀ i ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      0 ≤ trans3 leaf43Coeff 10 7 3 ((15/16) : ℚ) ((1/16) : ℚ) ((45/64) : ℚ) ((15/64) : ℚ) ((1/2) : ℚ) ((1/4) : ℚ) i j k := by
  have exactTable := checked_trans3 leaf43Coeff leaf43S1 leaf43S2 leaf43S3 10 7 3 ((15/16) : ℚ) ((1/16) : ℚ) ((45/64) : ℚ) ((15/64) : ℚ) ((1/2) : ℚ) ((1/4) : ℚ) leaf43W1 leaf43W2 leaf43W3
    leaf43W1Correct leaf43W2Correct leaf43W3Correct
    (axis1Correct_of_table leaf43InputCorrect leaf43S1Correct) leaf43S2Correct leaf43S3Correct
  intro i hi j hj k hk
  rw [← exactTable i hi j hj k hk]
  exact leaf43Signs i hi j hj k hk

theorem leaf43 {x d u : ℝ}
    (hx0 : (15/16 : ℝ) ≤ x)
    (hx1 : x ≤ (1 : ℝ))
    (hd0 : (45/64 : ℝ) ≤ d)
    (hd1 : d ≤ (15/16 : ℝ))
    (hu0 : (1/2 : ℝ) ≤ u)
    (hu1 : u ≤ (3/4 : ℝ)) :
    0 ≤ junctionFace1Target x d u - (0 : ℝ) * junctionFace1Constraint0 x d u - (0 : ℝ) * junctionFace1Constraint1 x d u := by
  have h : 0 ≤ msum leaf43Coeff 10 7 3 x d u :=
    msum_nonneg_on_box leaf43Coeff 10 7 3
      (by norm_num) (by norm_num) (by norm_num)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith) (by push_cast; linarith) leaf43Certificate
  rwa [leaf43Identity] at h


