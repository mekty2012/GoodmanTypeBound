private theorem leaf42S1NumerCorrect :
    ∀ h ∈ range 11, ∀ j ∈ range 8, ∀ k ∈ range 4,
      leaf42S1Numer h j k = ∑ i ∈ range 11, leaf42InputNumer i j k * leaf42W1Numer h i := by
  decide +kernel

