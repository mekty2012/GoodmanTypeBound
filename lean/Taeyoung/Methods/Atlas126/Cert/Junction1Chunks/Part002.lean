private theorem leaf42S2NumerCorrect :
    ∀ k ∈ range 11, ∀ j ∈ range 8, ∀ h ∈ range 4,
      leaf42S2Numer k j h = ∑ i ∈ range 8, leaf42S1Numer k i h * leaf42W2Numer j i := by
  decide +kernel

private theorem leaf42S2Correct : Axis2Correct 10 7 3 leaf42W2 leaf42S1 leaf42S2 := by
  intro k hk j hj h hh
  have he := scaled_dot_eq (fun i => leaf42S1Numer k i h) (leaf42W2Numer j) (leaf42S2Numer k j h) 1424967069597696 4398046511104 7
    (leaf42S2NumerCorrect k hk j hj h hh)
  norm_num only [show (1424967069597696 : ℚ)*4398046511104 = 6267071448882237641676816384 by norm_num] at he
  exact he

