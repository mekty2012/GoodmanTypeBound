  intro h hh j hj k hk
  have he := scaled_dot_eq (fun i => leaf42InputNumer i j k) (leaf42W1Numer h) (leaf42S1Numer h j k) 1296 1099511627776 10
    (leaf42S1NumerCorrect h hh j hj k hk)
