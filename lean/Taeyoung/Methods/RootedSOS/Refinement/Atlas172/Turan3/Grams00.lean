def H (i j : Nat) : Int := HData.get (i * 20 + j)

def Pt (i j : Nat) : Int := P j i
def Nt (i j : Nat) : Int := N j i

private def GPEnc : PackedTable :=
(.leaf (1000000))

private theorem GP_left_bound : ∀ (i : Fin 1) (j : Fin 1), (G i j).natAbs ≤ 5054400000000000000000 := by decide +kernel
private theorem GP_right_bound : ∀ (i : Fin 1) (j : Fin 1), (P i j).natAbs ≤ 1000000 := by decide +kernel
private theorem GP_result_bound : ∀ (i : Fin 1) (j : Fin 1), (K i j).natAbs ≤ 5054400000000000000000000000 := by decide +kernel
private theorem GP_encoded : ∀ i : Fin 1,
    GPEnc.get i = ∑ j : Fin 1, P i j * (10108800000000000000000000001 : Int)^j.1 := by decide +kernel
private theorem GP_product : ∀ i : Fin 1,
    shiftedEncoding 10108800000000000000000000001 5054400000000000000000000000 (List.ofFn fun j : Fin 1 => K i j) =
      5054400000000000000000000000 * geometricEncoding 10108800000000000000000000001 1 +
        ∑ j : Fin 1, G i j * GPEnc.get j := by decide +kernel

theorem GP_exact (i : Fin 1) (j : Fin 1) :
    K i j = ∑ k : Fin 1, G i k * P k j :=
  packed_rect_product_exact G P K
    5054400000000000000000 1000000 5054400000000000000000000000 10108800000000000000000000001 (fun i => GPEnc.get i)
    GP_left_bound GP_right_bound GP_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    GP_encoded GP_product i j

private def PKEnc : PackedTable :=
(.leaf (5054400000000000000000000000))

private theorem PK_left_bound : ∀ (i : Fin 1) (j : Fin 1), (Pt i j).natAbs ≤ 1000000 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 1) (j : Fin 1), (K i j).natAbs ≤ 5054400000000000000000000000 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 1) (j : Fin 1), (B i j).natAbs ≤ 5054400000000000000000000000000000 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 1,
    PKEnc.get i = ∑ j : Fin 1, K i j * (10108800000000000000000000000000001 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 1,
    shiftedEncoding 10108800000000000000000000000000001 5054400000000000000000000000000000 (List.ofFn fun j : Fin 1 => B i j) =
      5054400000000000000000000000000000 * geometricEncoding 10108800000000000000000000000000001 1 +
        ∑ j : Fin 1, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 1) (j : Fin 1) :
    B i j = ∑ k : Fin 1, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    1000000 5054400000000000000000000000 5054400000000000000000000000000000 10108800000000000000000000000000001 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 1, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 1, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 1, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 1,
  (∑ j : Fin 1, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 1, 0 ≤ B i i := by decide +kernel
theorem gram_nonneg (x : Fin 1 → Real) : 0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

private def NGProductEnc : PackedTable :=
(.leaf (5054400000000000000000))

private theorem NGProduct_left_bound : ∀ (i : Fin 20) (j : Fin 1), (N i j).natAbs ≤ 1 := by decide +kernel
private theorem NGProduct_right_bound : ∀ (i : Fin 1) (j : Fin 1), (G i j).natAbs ≤ 5054400000000000000000 := by decide +kernel
private theorem NGProduct_result_bound : ∀ (i : Fin 20) (j : Fin 1), (NG i j).natAbs ≤ 5054400000000000000000 := by decide +kernel
private theorem NGProduct_encoded : ∀ i : Fin 1,
    NGProductEnc.get i = ∑ j : Fin 1, G i j * (10108800000000000000001 : Int)^j.1 := by decide +kernel
private theorem NGProduct_product : ∀ i : Fin 20,
    shiftedEncoding 10108800000000000000001 5054400000000000000000 (List.ofFn fun j : Fin 1 => NG i j) =
      5054400000000000000000 * geometricEncoding 10108800000000000000001 1 +
        ∑ j : Fin 1, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 20) (j : Fin 1) :
    NG i j = ∑ k : Fin 1, N i k * G k j :=
  packed_rect_product_exact N G NG
    1 5054400000000000000000 5054400000000000000000 10108800000000000000001 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

private def FullProductEnc : PackedTable :=
(.leaf (0))

private theorem FullProduct_left_bound : ∀ (i : Fin 20) (j : Fin 1), (NG i j).natAbs ≤ 1 := by decide +kernel
private theorem FullProduct_right_bound : ∀ (i : Fin 1) (j : Fin 20), (Nt i j).natAbs ≤ 1 := by decide +kernel
private theorem FullProduct_result_bound : ∀ (i : Fin 20) (j : Fin 20), (H i j).natAbs ≤ 1 := by decide +kernel
private theorem FullProduct_encoded : ∀ i : Fin 1,
    FullProductEnc.get i = ∑ j : Fin 20, Nt i j * (3 : Int)^j.1 := by decide +kernel
private theorem FullProduct_product : ∀ i : Fin 20,
    shiftedEncoding 3 1 (List.ofFn fun j : Fin 20 => H i j) =
      1 * geometricEncoding 3 20 +
        ∑ j : Fin 1, NG i j * FullProductEnc.get j := by decide +kernel

theorem FullProduct_exact (i : Fin 20) (j : Fin 20) :
    H i j = ∑ k : Fin 1, NG i k * Nt k j :=
  packed_rect_product_exact NG Nt H
    1 1 1 3 (fun i => FullProductEnc.get i)
    FullProduct_left_bound FullProduct_right_bound FullProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    FullProduct_encoded FullProduct_product i j

theorem expanded_entries_exact (i j : Fin 20) :
    H i j = ∑ k : Fin 1, (∑ l : Fin 1, N i l * G l k) * N j k := by
  rw [FullProduct_exact]
  apply Finset.sum_congr rfl
  intro k _
  rw [NGProduct_exact]
  rfl
theorem pulled_nonneg (x : Fin 20 → Real) :
    0 ≤ matrixQuadratic (fun i j => (H i j : Real)) x :=
  Induced.integer_rectangular_pullback_nonneg (fun i j => G i j) (fun i j => N i j)
    (fun i j => H i j) gram_nonneg expanded_entries_exact x
