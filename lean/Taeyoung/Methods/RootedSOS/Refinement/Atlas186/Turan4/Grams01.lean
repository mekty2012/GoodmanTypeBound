    NGProductEnc.get i = ∑ j : Fin 1, G i j * (6647040000000000000001 : Int)^j.1 := by decide +kernel
private theorem NGProduct_product : ∀ i : Fin 16,
    shiftedEncoding 6647040000000000000001 3323520000000000000000 (List.ofFn fun j : Fin 1 => NG i j) =
      3323520000000000000000 * geometricEncoding 6647040000000000000001 1 +
        ∑ j : Fin 1, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 16) (j : Fin 1) :
    NG i j = ∑ k : Fin 1, N i k * G k j :=
  packed_rect_product_exact N G NG
    1 3323520000000000000000 3323520000000000000000 6647040000000000000001 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

private def FullProductEnc : PackedTable :=
(.leaf (0))

private theorem FullProduct_left_bound : ∀ (i : Fin 16) (j : Fin 1), (NG i j).natAbs ≤ 1 := by decide +kernel
private theorem FullProduct_right_bound : ∀ (i : Fin 1) (j : Fin 16), (Nt i j).natAbs ≤ 1 := by decide +kernel
