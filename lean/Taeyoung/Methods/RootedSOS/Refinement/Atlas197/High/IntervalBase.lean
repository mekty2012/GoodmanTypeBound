theorem targetNumerator_eval (s : Real) :
    (∑ k : Fin 6, (targetNumerator k : Real)*Induced.basis 5 s k.1) =
      denominator*target197 ((1-s)*((3 : Real)/4)+s*(1 : Real)) := by
