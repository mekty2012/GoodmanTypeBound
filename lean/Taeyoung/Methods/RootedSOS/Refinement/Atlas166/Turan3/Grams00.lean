private theorem NGProduct_left_bound : ∀ (i : Fin 20) (j : Fin 1), (N i j).natAbs ≤ 1 := by decide +kernel
private theorem NGProduct_right_bound : ∀ (i : Fin 1) (j : Fin 1), (G i j).natAbs ≤ 2527200000000000000000 := by decide +kernel
