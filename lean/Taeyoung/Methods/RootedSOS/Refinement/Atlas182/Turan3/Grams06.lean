    GPEnc.get i = ∑ j : Fin 1, P i j * (252720000000000000000000001 : Int)^j.1 := by decide +kernel
private theorem GP_product : ∀ i : Fin 1,
    shiftedEncoding 252720000000000000000000001 126360000000000000000000000 (List.ofFn fun j : Fin 1 => K i j) =
      126360000000000000000000000 * geometricEncoding 252720000000000000000000001 1 +
        ∑ j : Fin 1, G i j * GPEnc.get j := by decide +kernel

theorem GP_exact (i : Fin 1) (j : Fin 1) :
