def countCode (i j : Fin 20) : Nat := (countData.get (i.1*20+j.1)).toNat
def coefficient (i j : Fin 20) (g : Fin 156) : Int :=
  decodeSignedDigit 65537 32768 (countCode i j) g
def completedHost (i j : Fin 20) (a : Fin (size i)) (b : Fin (size j)) (c : Fin 16) : Fin 156 :=
  host (Taeyoung.Methods.RootedSOS.Induced.Six.Config02.completion 0 (memberCode i a) (memberCode j b) c)
def pairEquation (i j : Fin 20) : Prop :=
  (countCode i j : Int) =  +
    ∑ a : Fin (size i), ∑ b : Fin (size j), ∑ c : Fin 16, groupPower (completedHost i j a b c)
instance (i j : Fin 20) : Decidable (pairEquation i j) := by unfold pairEquation; infer_instance
theorem card_bound : ∀ i j : Fin 20, size i*(size j*16) ≤ 32768 := by decide +kernel
