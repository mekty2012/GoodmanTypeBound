import Taeyoung.Methods.RootedSOS.Induced.Six.Classification
import Taeyoung.Methods.RootedSOS.Induced.Six.Powers
import Taeyoung.Methods.RootedSOS.Induced.HomExpansion
import Taeyoung.Methods.RootedSOS.Induced.PatternCode
import Taeyoung.Methods.RootedSOS.Induced.Counts
import Taeyoung.Foundation.FiniteGraphEncoding

namespace Taeyoung.Methods.RootedSOS.Induced.Six.HomEdge04
set_option maxRecDepth 1000000
set_option maxHeartbeats 40000000
open Finset MeasureTheory Taeyoung
open Taeyoung.Methods.RootedSOS.Induced Taeyoung.Methods.RootedSOS.Induced.Six
def graph : SimpleGraph (Fin 6) := graphFromEdges 6 [(1, 2), (1, 3), (2, 3), (4, 5)]
instance : DecidableRel graph.Adj := by unfold graph; infer_instance
def presentIndex : Fin 4 → Fin 15 := ![5, 6, 9, 14]
def freeIndex : Fin 11 → Fin 15 := ![0, 1, 2, 3, 4, 7, 8, 10, 11, 12, 13]
def edgeMap : Fin 4 ⊕ Fin 11 → Fin 15 := Sum.elim presentIndex freeIndex
def edgeInv : Fin 15 → Fin 4 ⊕ Fin 11 := ![Sum.inr 0, Sum.inr 1, Sum.inr 2, Sum.inr 3, Sum.inr 4, Sum.inl 0, Sum.inl 1, Sum.inr 5, Sum.inr 6, Sum.inl 2, Sum.inr 7, Sum.inr 8, Sum.inr 9, Sum.inr 10, Sum.inl 3]
private theorem edge_left : ∀ e, edgeInv (edgeMap e) = e := by decide +kernel
private theorem edge_right : ∀ e, edgeMap (edgeInv e) = e := by decide +kernel
def edgeEquiv : Fin 4 ⊕ Fin 11 ≃ Fin 15 := ⟨edgeMap,edgeInv,edge_left,edge_right⟩
private theorem present_injective : Function.Injective
    (fun i : Fin 4 => s((pairs (edgeEquiv (.inl i))).1,(pairs (edgeEquiv (.inl i))).2)) := by decide +kernel
private theorem edges_exact : graph.edgeFinset = univ.image
    (fun i : Fin 4 => s((pairs (edgeEquiv (.inl i))).1,(pairs (edgeEquiv (.inl i))).2)) := by decide +kernel
def completion (a : Fin 2048) : Fin 32768 :=
  patternCode edgeEquiv (Sum.elim (fun _ => 1) (finFunctionFinEquiv.symm a))
private def histogramData : PackedTable := (.node 2 (.node 1 (.leaf ())
(.leaf ()))
(.node 1 (.leaf ())
(.leaf ())))
def histogram (b : Fin 4) : Int := histogramData.get b
def countCode : Nat := 
def coefficient (g : Fin 156) : Int := decodeSignedDigit 65537 32768 countCode g
private theorem count_total : (countCode : Int) =  + ∑ b, histogram b := by decide +kernel
private theorem block_000 : histogram 0 =
    ∑ i : Fin 512, groupPower (host (completion (finProdFinEquiv ((0 : Fin 4),i)))) := by decide +kernel
private theorem block_001 : histogram 1 =
    ∑ i : Fin 512, groupPower (host (completion (finProdFinEquiv ((1 : Fin 4),i)))) := by decide +kernel
private theorem block_002 : histogram 2 =
    ∑ i : Fin 512, groupPower (host (completion (finProdFinEquiv ((2 : Fin 4),i)))) := by decide +kernel
private theorem block_003 : histogram 3 =
    ∑ i : Fin 512, groupPower (host (completion (finProdFinEquiv ((3 : Fin 4),i)))) := by decide +kernel
theorem histogram_exact (b : Fin 4) : histogram b =
    ∑ i : Fin 512, groupPower (host (completion (finProdFinEquiv (b,i)))) := by
  fin_cases b
  · exact block_000
  · exact block_001
  · exact block_002
  · exact block_003

theorem countCode_exact : (countCode : Int) = (32768 : Int)*geometricEncoding 65537 156 +
    ∑ a : Fin 2048, (65537 : Int)^(host (completion a)).1 := by
  rw [histogram_offset]
  rw [← (finProdFinEquiv : Fin 4 × Fin 512 ≃ Fin 2048).sum_comp
    (fun a : Fin 2048 => (65537 : Int)^(host (completion a)).1)]
  simp only [Fintype.sum_prod_type]
  simp_rw [← groupPower_exact, ← histogram_exact]
  exact count_total
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
theorem hom_expansion (W : Graphon Ω μ) : homDensity graph W =
    ∑ a : Fin 2048, density (host (completion a)) W := by
  rw [homDensity_completions graph pairs edgeEquiv present_injective edges_exact W]
  rw [← finFunctionFinEquiv.symm.sum_comp (fun q : Fin 11 → Fin 2 =>
    inducedDensity pairs (fun i => Sum.elim (fun _ => 1) q (edgeEquiv.symm i)) W)]
  apply Finset.sum_congr rfl
  intro a _
  have h := inducedDensity_classification (completion a) W
  simpa only [completion, patternCode, bits, Equiv.symm_apply_apply] using h
theorem density_expansion (W : Graphon Ω μ) : homDensity graph W =
    ∑ g : Fin 156, (coefficient g : Real)*density g W := by
  rw [hom_expansion]
  exact count_density_sum (fun a : Fin 2048 => host (completion a))
    (by decide) (by norm_num) countCode_exact (fun g => density g W)
#print axioms density_expansion
end Taeyoung.Methods.RootedSOS.Induced.Six.HomEdge04
