set_option maxRecDepth 1000000
set_option maxHeartbeats 40000000
open Finset
abbrev Root := Fin 0
abbrev Branch := Fin 3
abbrev Vertex := Root ⊕ (Branch ⊕ Branch)
abbrev RootEdge := Fin 0
abbrev BranchEdge := Fin 3
abbrev CrossEdge := Fin 9
abbrev Edge := (RootEdge ⊕ (BranchEdge ⊕ BranchEdge)) ⊕ CrossEdge
def rootPairs : RootEdge → Root × Root := ![]
def branchPairs : BranchEdge → (Root ⊕ Branch) × (Root ⊕ Branch) := ![((Sum.inr 0),(Sum.inr 1)), ((Sum.inr 0),(Sum.inr 2)), ((Sum.inr 1),(Sum.inr 2))]
def crossPairs : CrossEdge → Branch × Branch := ![(0,0), (0,1), (0,2), (1,0), (1,1), (1,2), (2,0), (2,1), (2,2)]
def allPairs : Edge → Vertex × Vertex := gluedPairs rootPairs branchPairs crossPairs
def vertexMap : Vertex → Fin 6 := Sum.elim (fun i => ⟨i.1, by omega⟩)
  (Sum.elim (fun i => ⟨0+i.1, by omega⟩) (fun i => ⟨3+i.1, by omega⟩))
def vertexInv (i : Fin 6) : Vertex :=
  if h : i.1 < 0 then Sum.inl ⟨i.1,h⟩ else
  if h' : i.1 < 3 then Sum.inr (Sum.inl ⟨i.1-0,by omega⟩)
  else Sum.inr (Sum.inr ⟨i.1-3,by omega⟩)
def rootIndex : RootEdge → Fin 15 := ![]
def firstIndex : BranchEdge → Fin 15 := ![0, 1, 5]
def secondIndex : BranchEdge → Fin 15 := ![12, 13, 14]
def crossIndex : CrossEdge → Fin 15 := ![2, 3, 4, 6, 7, 8, 9, 10, 11]
def edgeMap : Edge → Fin 15 := Sum.elim (Sum.elim rootIndex (Sum.elim firstIndex secondIndex)) crossIndex
def edgeInv : Fin 15 → Edge := ![Sum.inl (Sum.inr (Sum.inl 0)), Sum.inl (Sum.inr (Sum.inl 1)), Sum.inr 0, Sum.inr 1, Sum.inr 2, Sum.inl (Sum.inr (Sum.inl 2)), Sum.inr 3, Sum.inr 4, Sum.inr 5, Sum.inr 6, Sum.inr 7, Sum.inr 8, Sum.inl (Sum.inr (Sum.inr 0)), Sum.inl (Sum.inr (Sum.inr 1)), Sum.inl (Sum.inr (Sum.inr 2))]
private theorem vertex_left : ∀ v, vertexInv (vertexMap v) = v := by decide +kernel
private theorem vertex_right : ∀ v, vertexMap (vertexInv v) = v := by decide +kernel
private theorem edge_left : ∀ e, edgeInv (edgeMap e) = e := by decide +kernel
private theorem edge_right : ∀ e, edgeMap (edgeInv e) = e := by decide +kernel
def vertexEquiv : Vertex ≃ Fin 6 := ⟨vertexMap,vertexInv,vertex_left,vertex_right⟩
def edgeEquiv : Edge ≃ Fin 15 := ⟨edgeMap,edgeInv,edge_left,edge_right⟩
@[simp] theorem edgeEquiv_apply (e : Edge) : edgeEquiv e = edgeMap e := rfl
theorem pairs_exact : ∀ e, vertexMap (allPairs e).1 = (pairs (edgeMap e)).1 ∧
    vertexMap (allPairs e).2 = (pairs (edgeMap e)).2 := by decide +kernel
def rootBits (a : Fin 1) : RootEdge → Fin 2 := finFunctionFinEquiv.symm a
def branchBits (a : Fin 8) : BranchEdge → Fin 2 := finFunctionFinEquiv.symm a
def crossBits (a : Fin 512) : CrossEdge → Fin 2 := finFunctionFinEquiv.symm a

