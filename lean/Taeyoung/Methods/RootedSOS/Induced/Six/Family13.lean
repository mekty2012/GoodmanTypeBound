theorem code_exact (i j : Fin 16) :
    (countCode i j : Int) = (32768 : Int)*geometricEncoding 65537 156 +
      ∑ q : Fin (size i) × (Fin (size j) × Fin 2),
        (65537 : Int)^(completedHost i j q.1 q.2.1 q.2.2).1 := by
  rw [histogram_offset]
  simpa only [pairEquation, Fintype.sum_prod_type, groupPower_exact] using pairEquation_all i j
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
noncomputable def pair (W : Taeyoung.Graphon Ω μ) (i j : Fin 16) : Real :=
  familyPair Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootPairs (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootBits 63) Taeyoung.Methods.RootedSOS.Induced.Six.Config04.branchPairs size member W i j
theorem pair_density (W : Taeyoung.Graphon Ω μ) (i j : Fin 16) :
    pair W i j = ∑ g : Fin 156, (coefficient i j g : Real)*density g W := by
  have hc := count_density_sum
    (fun q : Fin (size i) × (Fin (size j) × Fin 2) => completedHost i j q.1 q.2.1 q.2.2)
    (by decide : 65537 = 2*32768+1)
    (by simpa only [Fintype.card_prod, Fintype.card_fin] using card_bound i j)
    (code_exact i j) (fun g => density g W)
  change pair W i j = ∑ g : Fin 156, (decodeSignedDigit 65537 32768 (countCode i j) g : Real)*density g W
  rw [← hc]
  simp only [Fintype.sum_prod_type]
  unfold pair
  rw [familyPair_expansion Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootPairs (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootBits 63)
    Taeyoung.Methods.RootedSOS.Induced.Six.Config04.branchPairs Taeyoung.Methods.RootedSOS.Induced.Six.Config04.crossPairs size member W]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro b _
  rw [← finFunctionFinEquiv.symm.sum_comp (fun c : Taeyoung.Methods.RootedSOS.Induced.Six.Config04.CrossEdge → Fin 2 =>
    inducedDensity (gluedPairs Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootPairs Taeyoung.Methods.RootedSOS.Induced.Six.Config04.branchPairs Taeyoung.Methods.RootedSOS.Induced.Six.Config04.crossPairs)
      (gluedPattern (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootBits 63) (member i a) (member j b) c) W)]
  apply Finset.sum_congr rfl
  intro c _
  change inducedDensity Taeyoung.Methods.RootedSOS.Induced.Six.Config04.allPairs
    (gluedPattern (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootBits 63)
      (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.branchBits (memberCode i a)) (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.branchBits (memberCode j b)) (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.crossBits c)) W = _
  rw [Taeyoung.Methods.RootedSOS.Induced.Six.Config04.completion_density, inducedDensity_classification]
  rfl
theorem gram_nonneg (W : Taeyoung.Graphon Ω μ) (G : Fin 16 → Fin 16 → Real)
    (hG : ∀ x, 0 ≤ matrixQuadratic G x) :
    0 ≤ ∑ i, ∑ j, G i j * (∑ g : Fin 156, (coefficient i j g : Real)*density g W) := by
  have h := family_gram_nonneg Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootPairs (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.rootBits 63)
    Taeyoung.Methods.RootedSOS.Induced.Six.Config04.branchPairs size member W G hG
  change 0 ≤ ∑ i, ∑ j, G i j * pair W i j at h
  simp_rw [pair_density] at h
  exact h
#print axioms gram_nonneg
