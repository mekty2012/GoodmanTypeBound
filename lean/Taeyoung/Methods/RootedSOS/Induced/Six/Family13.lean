def countCode (i j : Fin 16) : Nat := (countData.get (i.1*16+j.1)).toNat
def coefficient (i j : Fin 16) (g : Fin 156) : Int :=
  decodeSignedDigit 65537 32768 (countCode i j) g
def completedHost (i j : Fin 16) (a : Fin (size i)) (b : Fin (size j)) (c : Fin 2) : Fin 156 :=
  host (Taeyoung.Methods.RootedSOS.Induced.Six.Config04.completion 63 (memberCode i a) (memberCode j b) c)
def pairEquation (i j : Fin 16) : Prop :=
  (countCode i j : Int) =  +
    ∑ a : Fin (size i), ∑ b : Fin (size j), ∑ c : Fin 2, groupPower (completedHost i j a b c)
instance (i j : Fin 16) : Decidable (pairEquation i j) := by unfold pairEquation; infer_instance
theorem card_bound : ∀ i j : Fin 16, size i*(size j*2) ≤ 32768 := by decide +kernel
