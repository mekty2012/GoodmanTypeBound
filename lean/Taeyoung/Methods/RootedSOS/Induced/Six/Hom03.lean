theorem histogram_exact (b : Fin 16) : histogram b =
    ∑ i : Fin 512, groupPower (host (completion (finProdFinEquiv (b,i)))) := by
  fin_cases b
  · exact block_000
  · exact block_001
  · exact block_002
  · exact block_003
  · exact block_004
  · exact block_005
  · exact block_006
  · exact block_007
  · exact block_008
