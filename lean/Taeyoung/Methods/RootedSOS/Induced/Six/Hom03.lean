def graph : SimpleGraph (Fin 6) := graphFromEdges 6 [(0, 1), (2, 3)]
instance : DecidableRel graph.Adj := by unfold graph; infer_instance
def presentIndex : Fin 2 → Fin 15 := ![0, 9]
def freeIndex : Fin 13 → Fin 15 := ![1, 2, 3, 4, 5, 6, 7, 8, 10, 11, 12, 13, 14]
def edgeMap : Fin 2 ⊕ Fin 13 → Fin 15 := Sum.elim presentIndex freeIndex
def edgeInv : Fin 15 → Fin 2 ⊕ Fin 13 := ![Sum.inl 0, Sum.inr 0, Sum.inr 1, Sum.inr 2, Sum.inr 3, Sum.inr 4, Sum.inr 5, Sum.inr 6, Sum.inr 7, Sum.inl 1, Sum.inr 8, Sum.inr 9, Sum.inr 10, Sum.inr 11, Sum.inr 12]
private theorem edge_left : ∀ e, edgeInv (edgeMap e) = e := by decide +kernel
private theorem edge_right : ∀ e, edgeMap (edgeInv e) = e := by decide +kernel
def edgeEquiv : Fin 2 ⊕ Fin 13 ≃ Fin 15 := ⟨edgeMap,edgeInv,edge_left,edge_right⟩
private theorem present_injective : Function.Injective
    (fun i : Fin 2 => s((pairs (edgeEquiv (.inl i))).1,(pairs (edgeEquiv (.inl i))).2)) := by decide +kernel
private theorem edges_exact : graph.edgeFinset = univ.image
    (fun i : Fin 2 => s((pairs (edgeEquiv (.inl i))).1,(pairs (edgeEquiv (.inl i))).2)) := by decide +kernel
def completion (a : Fin 8192) : Fin 32768 :=
  patternCode edgeEquiv (Sum.elim (fun _ => 1) (finFunctionFinEquiv.symm a))
