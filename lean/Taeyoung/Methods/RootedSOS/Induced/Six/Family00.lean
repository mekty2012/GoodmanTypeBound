set_option maxRecDepth 1000000
set_option maxHeartbeats 40000000
open Finset MeasureTheory
def size : Fin 4 → Nat := ![1, 3, 3, 1]
private def memberData : PackedTable := (.node 6 (.node 3 (.node 1 (.leaf (0))
(.node 1 (.leaf (0))
(.leaf (0))))
(.node 1 (.leaf (1))
(.node 1 (.leaf (2))
(.leaf (4)))))
(.node 3 (.node 1 (.leaf (3))
(.node 1 (.leaf (5))
(.leaf (6))))
(.node 1 (.leaf (7))
(.node 1 (.leaf (0))
(.leaf (0))))))
def memberCode (i : Fin 4) (a : Fin (size i)) : Fin 8 :=
  ⟨(memberData.get (i.1*3+a.1)).toNat%8, Nat.mod_lt _ (by decide)⟩
def member (i : Fin 4) (a : Fin (size i)) : Taeyoung.Methods.RootedSOS.Induced.Six.Config00.BranchEdge → Fin 2 :=
  Taeyoung.Methods.RootedSOS.Induced.Six.Config00.branchBits (memberCode i a)
private def countData : PackedTable := (.node 8 (.node 4 (.node 2 (.node 1 (.leaf ())
(.leaf ()))
(.node 1 (.leaf ())
(.leaf ())))
(.node 2 (.node 1 (.leaf ())
(.leaf ()))
(.node 1 (.leaf ())
(.leaf ()))))
(.node 4 (.node 2 (.node 1 (.leaf ())
(.leaf ()))
(.node 1 (.leaf ())
(.leaf ())))
(.node 2 (.node 1 (.leaf ())
(.leaf ()))
(.node 1 (.leaf ())
(.leaf ())))))
def countCode (i j : Fin 4) : Nat := (countData.get (i.1*4+j.1)).toNat
def coefficient (i j : Fin 4) (g : Fin 156) : Int :=
  decodeSignedDigit 65537 32768 (countCode i j) g
def completedHost (i j : Fin 4) (a : Fin (size i)) (b : Fin (size j)) (c : Fin 512) : Fin 156 :=
  host (Taeyoung.Methods.RootedSOS.Induced.Six.Config00.completion 0 (memberCode i a) (memberCode j b) c)
def pairEquation (i j : Fin 4) : Prop :=
  (countCode i j : Int) =  +
    ∑ a : Fin (size i), ∑ b : Fin (size j), ∑ c : Fin 512, groupPower (completedHost i j a b c)
instance (i j : Fin 4) : Decidable (pairEquation i j) := by unfold pairEquation; infer_instance
theorem card_bound : ∀ i j : Fin 4, size i*(size j*512) ≤ 32768 := by decide +kernel
private theorem check_00_00 : pairEquation 0 0 := by decide +kernel
private theorem check_00_01 : pairEquation 0 1 := by decide +kernel
private theorem check_00_02 : pairEquation 0 2 := by decide +kernel
private theorem check_00_03 : pairEquation 0 3 := by decide +kernel
private theorem row_00 (j : Fin 4) : pairEquation 0 j := by
  fin_cases j
  · exact check_00_00
  · exact check_00_01
  · exact check_00_02
  · exact check_00_03
private theorem check_01_00 : pairEquation 1 0 := by decide +kernel
private theorem check_01_01 : pairEquation 1 1 := by decide +kernel
private theorem check_01_02 : pairEquation 1 2 := by decide +kernel
private theorem check_01_03 : pairEquation 1 3 := by decide +kernel
private theorem row_01 (j : Fin 4) : pairEquation 1 j := by
  fin_cases j
  · exact check_01_00
  · exact check_01_01
