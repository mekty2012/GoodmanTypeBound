private theorem check_03_00 : pairEquation 3 0 := by decide +kernel
private theorem check_03_01 : pairEquation 3 1 := by decide +kernel
private theorem check_03_02 : pairEquation 3 2 := by decide +kernel
private theorem check_03_03 : pairEquation 3 3 := by decide +kernel
