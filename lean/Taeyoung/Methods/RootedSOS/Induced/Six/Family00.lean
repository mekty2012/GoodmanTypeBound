  · exact check_01_03
private theorem check_02_00 : pairEquation 2 0 := by decide +kernel
private theorem check_02_01 : pairEquation 2 1 := by decide +kernel
private theorem check_02_02 : pairEquation 2 2 := by decide +kernel
private theorem check_02_03 : pairEquation 2 3 := by decide +kernel
private theorem row_02 (j : Fin 4) : pairEquation 2 j := by
