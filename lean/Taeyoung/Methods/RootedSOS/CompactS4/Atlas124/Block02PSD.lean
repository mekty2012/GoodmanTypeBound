private theorem PK_product : ∀ i : Fin 58,
    shiftedEncoding 76394529342043584537578379264001 38197264671021792268789189632000 (List.ofFn fun j : Fin 58 => B i j) =
      38197264671021792268789189632000 * geometricEncoding 76394529342043584537578379264001 58 +
        ∑ j : Fin 58, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 58) (j : Fin 58) :
