private theorem upper : ∀ i j : Fin 58, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 58, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 58, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 58,
    (∑ j : Fin 58, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 58, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 58 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
