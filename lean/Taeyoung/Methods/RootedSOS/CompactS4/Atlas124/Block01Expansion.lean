    shiftedEncoding 85324899019235329 42662449509617664 (List.ofFn fun j : Fin 93 => NG i j) =
      42662449509617664 * geometricEncoding 85324899019235329 93 +
        ∑ j : Fin 93, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 104) (j : Fin 93) :
    NG i j = ∑ k : Fin 93, N i k * G k j :=
  packed_rect_product_exact N G NG
    12 38228001352704 42662449509617664 85324899019235329 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

