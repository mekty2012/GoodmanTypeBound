private theorem GP_left_bound : ∀ (i : Fin 20) (j : Fin 20), (G i j).natAbs ≤ 1648195869312 := by decide +kernel
private theorem GP_right_bound : ∀ (i : Fin 20) (j : Fin 20), (P i j).natAbs ≤ 1238799296 := by decide +kernel
