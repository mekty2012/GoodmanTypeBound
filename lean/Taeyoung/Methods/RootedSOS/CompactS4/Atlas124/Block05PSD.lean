private theorem PK_left_bound : ∀ (i : Fin 20) (j : Fin 20), (Pt i j).natAbs ≤ 1238799296 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 20) (j : Fin 20), (K i j).natAbs ≤ 109494976222515195648 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 20) (j : Fin 20), (B i j).natAbs ≤ 2712845989199771274360893276160 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 20,
    PKEnc.get i = ∑ j : Fin 20, K i j * (5425691978399542548721786552321 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 20,
    shiftedEncoding 5425691978399542548721786552321 2712845989199771274360893276160 (List.ofFn fun j : Fin 20 => B i j) =
      2712845989199771274360893276160 * geometricEncoding 5425691978399542548721786552321 20 +
        ∑ j : Fin 20, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 20) (j : Fin 20) :
    B i j = ∑ k : Fin 20, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    1238799296 109494976222515195648 2712845989199771274360893276160 5425691978399542548721786552321 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 20, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 20, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 20, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 20,
    (∑ j : Fin 20, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 20, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 20 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

