private theorem PK_encoded : ∀ i : Fin 59,
    PKEnc.get i = ∑ j : Fin 59, K i j * (30670071024742695718870047795361 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 59,
    shiftedEncoding 30670071024742695718870047795361 15335035512371347859435023897680 (List.ofFn fun j : Fin 59 => B i j) =
      15335035512371347859435023897680 * geometricEncoding 30670071024742695718870047795361 59 +
        ∑ j : Fin 59, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 59) (j : Fin 59) :
    B i j = ∑ k : Fin 59, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    431151348 602841339468309517740 15335035512371347859435023897680 30670071024742695718870047795361 (fun i => PKEnc.get i)
