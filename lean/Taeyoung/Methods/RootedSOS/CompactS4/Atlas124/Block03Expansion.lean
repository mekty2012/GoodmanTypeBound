    shiftedEncoding 11123064650396161 5561532325198080 (List.ofFn fun j : Fin 59 => NG i j) =
      5561532325198080 * geometricEncoding 11123064650396161 59 +
        ∑ j : Fin 59, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 60) (j : Fin 59) :
    NG i j = ∑ k : Fin 59, N i k * G k j :=
  packed_rect_product_exact N G NG
    2 47131629874560 5561532325198080 11123064650396161 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

