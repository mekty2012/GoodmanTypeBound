private theorem PK_left_bound : ∀ (i : Fin 20) (j : Fin 20), (Pt i j).natAbs ≤ 2003010903 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 20) (j : Fin 20), (K i j).natAbs ≤ 83204274608244080640 := by decide +kernel
