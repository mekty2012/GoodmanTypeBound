    PKEnc.get i = ∑ j : Fin 44, K i j * (33546045170676460462416968537089 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 44,
    shiftedEncoding 33546045170676460462416968537089 16773022585338230231208484268544 (List.ofFn fun j : Fin 44 => B i j) =
      16773022585338230231208484268544 * geometricEncoding 33546045170676460462416968537089 44 +
        ∑ j : Fin 44, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 44) (j : Fin 44) :
    B i j = ∑ k : Fin 44, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    1471373097 259081166792386343808 16773022585338230231208484268544 33546045170676460462416968537089 (fun i => PKEnc.get i)
