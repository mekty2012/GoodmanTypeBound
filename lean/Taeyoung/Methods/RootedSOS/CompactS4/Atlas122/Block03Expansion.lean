private theorem NGProduct_left_bound : ∀ (i : Fin 60) (j : Fin 59), (N i j).natAbs ≤ 2 := by decide +kernel
private theorem NGProduct_right_bound : ∀ (i : Fin 59) (j : Fin 59), (G i j).natAbs ≤ 21201704163072 := by decide +kernel
private theorem NGProduct_result_bound : ∀ (i : Fin 60) (j : Fin 59), (NG i j).natAbs ≤ 2501801091242496 := by decide +kernel
private theorem NGProduct_encoded : ∀ i : Fin 59,
    NGProductEnc.get i = ∑ j : Fin 59, G i j * (5003602182484993 : Int)^j.1 := by decide +kernel
private theorem NGProduct_product : ∀ i : Fin 60,
    shiftedEncoding 5003602182484993 2501801091242496 (List.ofFn fun j : Fin 59 => NG i j) =
      2501801091242496 * geometricEncoding 5003602182484993 59 +
        ∑ j : Fin 59, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 60) (j : Fin 59) :
    NG i j = ∑ k : Fin 59, N i k * G k j :=
  packed_rect_product_exact N G NG
    2 21201704163072 2501801091242496 5003602182484993 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

