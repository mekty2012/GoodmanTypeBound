private theorem PK_left_bound : ∀ (i : Fin 59) (j : Fin 59), (Pt i j).natAbs ≤ 208365030 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 59) (j : Fin 59), (K i j).natAbs ≤ 443366241907456520964 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 59) (j : Fin 59), (B i j).natAbs ≤ 5450539197466031677647209846280 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 59,
    PKEnc.get i = ∑ j : Fin 59, K i j * (10901078394932063355294419692561 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 59,
    shiftedEncoding 10901078394932063355294419692561 5450539197466031677647209846280 (List.ofFn fun j : Fin 59 => B i j) =
      5450539197466031677647209846280 * geometricEncoding 10901078394932063355294419692561 59 +
        ∑ j : Fin 59, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 59) (j : Fin 59) :
    B i j = ∑ k : Fin 59, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    208365030 443366241907456520964 5450539197466031677647209846280 10901078394932063355294419692561 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 59, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 59, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 59, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 59,
    (∑ j : Fin 59, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 59, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 59 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

