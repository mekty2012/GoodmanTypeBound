private theorem PK_encoded : ∀ i : Fin 93,
    PKEnc.get i = ∑ j : Fin 93, K i j * (209114622553340083936633385041513 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 93,
    shiftedEncoding 209114622553340083936633385041513 104557311276670041968316692520756 (List.ofFn fun j : Fin 93 => B i j) =
      104557311276670041968316692520756 * geometricEncoding 209114622553340083936633385041513 93 +
        ∑ j : Fin 93, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 93) (j : Fin 93) :
