private theorem PK_left_bound : ∀ (i : Fin 58) (j : Fin 58), (Pt i j).natAbs ≤ 1537833139 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 58) (j : Fin 58), (K i j).natAbs ≤ 173743285083076876032 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 58) (j : Fin 58), (B i j).natAbs ≤ 15496914525809839306703056617984 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 58,
    PKEnc.get i = ∑ j : Fin 58, K i j * (30993829051619678613406113235969 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 58,
    shiftedEncoding 30993829051619678613406113235969 15496914525809839306703056617984 (List.ofFn fun j : Fin 58 => B i j) =
      15496914525809839306703056617984 * geometricEncoding 30993829051619678613406113235969 58 +
        ∑ j : Fin 58, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 58) (j : Fin 58) :
    B i j = ∑ k : Fin 58, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    1537833139 173743285083076876032 15496914525809839306703056617984 30993829051619678613406113235969 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
