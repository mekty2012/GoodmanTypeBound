private theorem GP_left_bound : ∀ (i : Fin 50) (j : Fin 50), (G i j).natAbs ≤ 2132788480704 := by decide +kernel
private theorem GP_right_bound : ∀ (i : Fin 50) (j : Fin 50), (P i j).natAbs ≤ 4877779607 := by decide +kernel
