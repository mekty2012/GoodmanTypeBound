private theorem PK_left_bound : ∀ (i : Fin 50) (j : Fin 50), (Pt i j).natAbs ≤ 4877779607 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 50) (j : Fin 50), (K i j).natAbs ≤ 84939323447658084192 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 50) (j : Fin 50), (B i j).natAbs ≤ 20715764987268176749021333627200 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 50,
    PKEnc.get i = ∑ j : Fin 50, K i j * (41431529974536353498042667254401 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 50,
    shiftedEncoding 41431529974536353498042667254401 20715764987268176749021333627200 (List.ofFn fun j : Fin 50 => B i j) =
      20715764987268176749021333627200 * geometricEncoding 41431529974536353498042667254401 50 +
        ∑ j : Fin 50, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 50) (j : Fin 50) :
    B i j = ∑ k : Fin 50, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    4877779607 84939323447658084192 20715764987268176749021333627200 41431529974536353498042667254401 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 50, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 50, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 50, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 50,
    (∑ j : Fin 50, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 50, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 50 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

