    shiftedEncoding 1040327215722248420332801 520163607861124210166400 (List.ofFn fun j : Fin 50 => K i j) =
      520163607861124210166400 * geometricEncoding 1040327215722248420332801 50 +
        ∑ j : Fin 50, G i j * GPEnc.get j := by decide +kernel

theorem GP_exact (i : Fin 50) (j : Fin 50) :
    K i j = ∑ k : Fin 50, G i k * P k j :=
  packed_rect_product_exact G P K
    2132788480704 4877779607 520163607861124210166400 1040327215722248420332801 (fun i => GPEnc.get i)
    GP_left_bound GP_right_bound GP_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    GP_encoded GP_product i j

