private theorem PK_left_bound : ∀ (i : Fin 48) (j : Fin 48), (Pt i j).natAbs ≤ 375394123 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 48) (j : Fin 48), (K i j).natAbs ≤ 361957952295834639552 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 48) (j : Fin 48), (B i j).natAbs ≤ 6522090627118592691246919339008 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 48,
    PKEnc.get i = ∑ j : Fin 48, K i j * (13044181254237185382493838678017 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 48,
    shiftedEncoding 13044181254237185382493838678017 6522090627118592691246919339008 (List.ofFn fun j : Fin 48 => B i j) =
      6522090627118592691246919339008 * geometricEncoding 13044181254237185382493838678017 48 +
        ∑ j : Fin 48, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 48) (j : Fin 48) :
    B i j = ∑ k : Fin 48, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    375394123 361957952295834639552 6522090627118592691246919339008 13044181254237185382493838678017 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
