private theorem PK_encoded : ∀ i : Fin 60,
    PKEnc.get i = ∑ j : Fin 60, K i j * (6398574874387285902680858181121 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 60,
    shiftedEncoding 6398574874387285902680858181121 3199287437193642951340429090560 (List.ofFn fun j : Fin 60 => B i j) =
      3199287437193642951340429090560 * geometricEncoding 6398574874387285902680858181121 60 +
        ∑ j : Fin 60, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 60) (j : Fin 60) :
    B i j = ∑ k : Fin 60, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    141105701 377883082743486854976 3199287437193642951340429090560 6398574874387285902680858181121 (fun i => PKEnc.get i)
