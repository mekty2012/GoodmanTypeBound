def codeValue (i j : Nat) : Int := codeValueData.get (i * 32 + j)

def root (i : Fin 32) (k : Fin (count i)) : Fin 352 :=
  ⟨(indexValue i k).toNat % 352, Nat.mod_lt _ (by decide)⟩
def value (i : Fin 32) (k : Fin (count i)) : Int := weight i k
def code (i j : Fin 32) : Nat := (codeValue i j).toNat

def TInt (a : Fin 352) (i : Fin 32) : Int :=
  ∑ k : Fin (count i), if root i k = a then value i k else 0

theorem count_bound : ∀ i : Fin 32, count i * maxValue i ≤ 24 := by decide +kernel
theorem value_bound : ∀ i : Fin 32, ∀ k : Fin (count i), (value i k).natAbs ≤ maxValue i := by decide +kernel

