private theorem PK_product : ∀ i : Fin 60,
    shiftedEncoding 7980963449400966709211858795521 3990481724700483354605929397760 (List.ofFn fun j : Fin 60 => B i j) =
      3990481724700483354605929397760 * geometricEncoding 7980963449400966709211858795521 60 +
        ∑ j : Fin 60, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 60) (j : Fin 60) :
