private theorem PK_left_bound : ∀ (i : Fin 62) (j : Fin 62), (Pt i j).natAbs ≤ 1326149280 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 62) (j : Fin 62), (K i j).natAbs ≤ 189273236064101251776 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 62) (j : Fin 62), (B i j).natAbs ≤ 15562283075240030351170149519360 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 62,
    PKEnc.get i = ∑ j : Fin 62, K i j * (31124566150480060702340299038721 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 62,
    shiftedEncoding 31124566150480060702340299038721 15562283075240030351170149519360 (List.ofFn fun j : Fin 62 => B i j) =
      15562283075240030351170149519360 * geometricEncoding 31124566150480060702340299038721 62 +
        ∑ j : Fin 62, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 62) (j : Fin 62) :
    B i j = ∑ k : Fin 62, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    1326149280 189273236064101251776 15562283075240030351170149519360 31124566150480060702340299038721 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
