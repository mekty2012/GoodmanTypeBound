private theorem NGProduct_product : ∀ i : Fin 68,
    shiftedEncoding 9391112300415745 4695556150207872 (List.ofFn fun j : Fin 62 => NG i j) =
      4695556150207872 * geometricEncoding 9391112300415745 62 +
        ∑ j : Fin 62, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 68) (j : Fin 62) :
    NG i j = ∑ k : Fin 62, N i k * G k j :=
  packed_rect_product_exact N G NG
    6 12622462769376 4695556150207872 9391112300415745 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

