private theorem NGProduct_left_bound : ∀ (i : Fin 68) (j : Fin 62), (N i j).natAbs ≤ 6 := by decide +kernel
private theorem NGProduct_right_bound : ∀ (i : Fin 62) (j : Fin 62), (G i j).natAbs ≤ 12622462769376 := by decide +kernel
