private theorem PK_left_bound : ∀ (i : Fin 50) (j : Fin 50), (Pt i j).natAbs ≤ 13313794190 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 50) (j : Fin 50), (K i j).natAbs ≤ 59570488263424745232 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 50) (j : Fin 50), (B i j).natAbs ≤ 39655461026852378128601590104000 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 50,
    PKEnc.get i = ∑ j : Fin 50, K i j * (79310922053704756257203180208001 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 50,
    shiftedEncoding 79310922053704756257203180208001 39655461026852378128601590104000 (List.ofFn fun j : Fin 50 => B i j) =
      39655461026852378128601590104000 * geometricEncoding 79310922053704756257203180208001 50 +
        ∑ j : Fin 50, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 50) (j : Fin 50) :
    B i j = ∑ k : Fin 50, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    13313794190 59570488263424745232 39655461026852378128601590104000 79310922053704756257203180208001 (fun i => PKEnc.get i)
