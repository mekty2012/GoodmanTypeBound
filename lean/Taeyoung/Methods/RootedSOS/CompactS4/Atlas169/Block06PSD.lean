private theorem PK_right_bound : ∀ (i : Fin 48) (j : Fin 48), (K i j).natAbs ≤ 94715931512763848160 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 48) (j : Fin 48), (B i j).natAbs ≤ 692160468233337443524744074240 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 48,
    PKEnc.get i = ∑ j : Fin 48, K i j * (1384320936466674887049488148481 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 48,
    shiftedEncoding 1384320936466674887049488148481 692160468233337443524744074240 (List.ofFn fun j : Fin 48 => B i j) =
      692160468233337443524744074240 * geometricEncoding 1384320936466674887049488148481 48 +
        ∑ j : Fin 48, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 48) (j : Fin 48) :
    B i j = ∑ k : Fin 48, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    152244818 94715931512763848160 692160468233337443524744074240 1384320936466674887049488148481 (fun i => PKEnc.get i)
