private theorem PK_left_bound : ∀ (i : Fin 23) (j : Fin 23), (Pt i j).natAbs ≤ 300889716 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 23) (j : Fin 23), (K i j).natAbs ≤ 48846433812620274288 := by decide +kernel
