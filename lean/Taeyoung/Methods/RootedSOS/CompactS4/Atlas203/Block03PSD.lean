private theorem PK_left_bound : ∀ (i : Fin 60) (j : Fin 60), (Pt i j).natAbs ≤ 178587134 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 60) (j : Fin 60), (K i j).natAbs ≤ 262347754849422091488 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 60) (j : Fin 60), (B i j).natAbs ≤ 2811116018993573572507662923520 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 60,
    PKEnc.get i = ∑ j : Fin 60, K i j * (5622232037987147145015325847041 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 60,
    shiftedEncoding 5622232037987147145015325847041 2811116018993573572507662923520 (List.ofFn fun j : Fin 60 => B i j) =
      2811116018993573572507662923520 * geometricEncoding 5622232037987147145015325847041 60 +
        ∑ j : Fin 60, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 60) (j : Fin 60) :
    B i j = ∑ k : Fin 60, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    178587134 262347754849422091488 2811116018993573572507662923520 5622232037987147145015325847041 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 60, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 60, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 60, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 60,
    (∑ j : Fin 60, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 60, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 60 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

