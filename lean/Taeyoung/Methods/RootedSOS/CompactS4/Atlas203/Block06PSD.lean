private theorem PK_left_bound : ∀ (i : Fin 48) (j : Fin 48), (Pt i j).natAbs ≤ 579987984 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 48) (j : Fin 48), (K i j).natAbs ≤ 204034882678062384672 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 48) (j : Fin 48), (B i j).natAbs ≤ 5680213452966044328582997499904 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 48,
    PKEnc.get i = ∑ j : Fin 48, K i j * (11360426905932088657165994999809 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 48,
    shiftedEncoding 11360426905932088657165994999809 5680213452966044328582997499904 (List.ofFn fun j : Fin 48 => B i j) =
      5680213452966044328582997499904 * geometricEncoding 11360426905932088657165994999809 48 +
        ∑ j : Fin 48, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 48) (j : Fin 48) :
    B i j = ∑ k : Fin 48, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    579987984 204034882678062384672 5680213452966044328582997499904 11360426905932088657165994999809 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 48, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 48, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 48, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 48,
    (∑ j : Fin 48, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 48, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 48 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

