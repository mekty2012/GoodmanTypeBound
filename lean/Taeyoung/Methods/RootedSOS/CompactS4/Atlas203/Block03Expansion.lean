private theorem NGProduct_left_bound : ∀ (i : Fin 60) (j : Fin 60), (N i j).natAbs ≤ 1 := by decide +kernel
private theorem NGProduct_right_bound : ∀ (i : Fin 60) (j : Fin 60), (G i j).natAbs ≤ 45745713352224 := by decide +kernel
