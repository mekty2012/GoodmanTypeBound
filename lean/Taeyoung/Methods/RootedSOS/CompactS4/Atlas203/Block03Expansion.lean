private theorem FullProduct_left_bound : ∀ (i : Fin 60) (j : Fin 60), (NG i j).natAbs ≤ 45745713352224 := by decide +kernel
private theorem FullProduct_right_bound : ∀ (i : Fin 60) (j : Fin 60), (Nt i j).natAbs ≤ 1 := by decide +kernel
private theorem FullProduct_result_bound : ∀ (i : Fin 60) (j : Fin 60), (H i j).natAbs ≤ 2744742801133440 := by decide +kernel
private theorem FullProduct_encoded : ∀ i : Fin 60,
    FullProductEnc.get i = ∑ j : Fin 60, Nt i j * (5489485602266881 : Int)^j.1 := by decide +kernel
private theorem FullProduct_product : ∀ i : Fin 60,
    shiftedEncoding 5489485602266881 2744742801133440 (List.ofFn fun j : Fin 60 => H i j) =
      2744742801133440 * geometricEncoding 5489485602266881 60 +
        ∑ j : Fin 60, NG i j * FullProductEnc.get j := by decide +kernel

theorem FullProduct_exact (i : Fin 60) (j : Fin 60) :
    H i j = ∑ k : Fin 60, NG i k * Nt k j :=
  packed_rect_product_exact NG Nt H
    45745713352224 1 2744742801133440 5489485602266881 (fun i => FullProductEnc.get i)
    FullProduct_left_bound FullProduct_right_bound FullProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    FullProduct_encoded FullProduct_product i j

theorem expanded_entries_exact (i j : Fin 60) :
    H i j = ∑ k : Fin 60, (∑ l : Fin 60, N i l * G l k) * N j k := by
  rw [FullProduct_exact]
  apply Finset.sum_congr rfl
  intro k _
  rw [NGProduct_exact]
  rfl

