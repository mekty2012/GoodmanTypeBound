    NGProductEnc.get i = ∑ j : Fin 60, G i j * (5489485602266881 : Int)^j.1 := by decide +kernel
private theorem NGProduct_product : ∀ i : Fin 60,
    shiftedEncoding 5489485602266881 2744742801133440 (List.ofFn fun j : Fin 60 => NG i j) =
      2744742801133440 * geometricEncoding 5489485602266881 60 +
        ∑ j : Fin 60, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 60) (j : Fin 60) :
    NG i j = ∑ k : Fin 60, N i k * G k j :=
  packed_rect_product_exact N G NG
    1 45745713352224 2744742801133440 5489485602266881 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

