private theorem PK_encoded : ∀ i : Fin 98,
    PKEnc.get i = ∑ j : Fin 98, K i j * (78526936496780745027050948384161 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 98,
    shiftedEncoding 78526936496780745027050948384161 39263468248390372513525474192080 (List.ofFn fun j : Fin 98 => B i j) =
      39263468248390372513525474192080 * geometricEncoding 78526936496780745027050948384161 98 +
        ∑ j : Fin 98, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 98) (j : Fin 98) :
    B i j = ∑ k : Fin 98, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    2637583182 151899526021339660780 39263468248390372513525474192080 78526936496780745027050948384161 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
