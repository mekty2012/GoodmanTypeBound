private theorem PK_product : ∀ i : Fin 23,
    shiftedEncoding 12665583220509797688168882477697 6332791610254898844084441238848 (List.ofFn fun j : Fin 23 => B i j) =
      6332791610254898844084441238848 * geometricEncoding 12665583220509797688168882477697 23 +
