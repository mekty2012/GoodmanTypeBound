private theorem PK_left_bound : ∀ (i : Fin 62) (j : Fin 62), (Pt i j).natAbs ≤ 3551823916 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 62) (j : Fin 62), (K i j).natAbs ≤ 99246320951190064992 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 62) (j : Fin 62), (B i j).natAbs ≤ 21855338292425821973011156817664 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 62,
    PKEnc.get i = ∑ j : Fin 62, K i j * (43710676584851643946022313635329 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 62,
    shiftedEncoding 43710676584851643946022313635329 21855338292425821973011156817664 (List.ofFn fun j : Fin 62 => B i j) =
      21855338292425821973011156817664 * geometricEncoding 43710676584851643946022313635329 62 +
        ∑ j : Fin 62, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 62) (j : Fin 62) :
    B i j = ∑ k : Fin 62, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    3551823916 99246320951190064992 21855338292425821973011156817664 43710676584851643946022313635329 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    PK_encoded PK_product i j

private theorem upper : ∀ i j : Fin 62, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 62, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 62, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 62,
    (∑ j : Fin 62, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 62, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 62 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

