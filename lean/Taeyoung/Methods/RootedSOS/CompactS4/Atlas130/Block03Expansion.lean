private theorem FullProduct_encoded : ∀ i : Fin 60,
    FullProductEnc.get i = ∑ j : Fin 60, Nt i j * (36981747307837441 : Int)^j.1 := by decide +kernel
private theorem FullProduct_product : ∀ i : Fin 60,
    shiftedEncoding 36981747307837441 18490873653918720 (List.ofFn fun j : Fin 60 => H i j) =
