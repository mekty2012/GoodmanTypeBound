theorem Lower.rightCheck_all (k : Fin 3632) : Lower.rightCheck k := by
  by_cases h : k.1 < 2048
  · let j : Fin 2048 := ⟨k.1-0, by omega⟩
    have he : (⟨0+j.1, by omega⟩ : Fin 3632) = k := by
      apply Fin.ext
      dsimp only [j] <;> omega
    simpa only [he] using LowerRightChecks_0000 j
  by_cases h : k.1 < 3632
  · let j : Fin 1584 := ⟨k.1-2048, by omega⟩
    have he : (⟨2048+j.1, by omega⟩ : Fin 3632) = k := by
      apply Fin.ext
      dsimp only [j] <;> omega
    simpa only [he] using LowerRightChecks_2048 j
  omega

