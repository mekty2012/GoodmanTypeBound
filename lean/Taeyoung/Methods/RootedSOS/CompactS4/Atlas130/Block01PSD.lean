private theorem PK_right_bound : ∀ (i : Fin 98) (j : Fin 98), (K i j).natAbs ≤ 1518550581362972664116 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 98) (j : Fin 98), (B i j).natAbs ≤ 453002120417250106312584840310424 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 98,
    PKEnc.get i = ∑ j : Fin 98, K i j * (906004240834500212625169680620849 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 98,
    shiftedEncoding 906004240834500212625169680620849 453002120417250106312584840310424 (List.ofFn fun j : Fin 98 => B i j) =
      453002120417250106312584840310424 * geometricEncoding 906004240834500212625169680620849 98 +
        ∑ j : Fin 98, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 98) (j : Fin 98) :
    B i j = ∑ k : Fin 98, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    3044001743 1518550581362972664116 453002120417250106312584840310424 906004240834500212625169680620849 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
