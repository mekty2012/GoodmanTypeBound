private theorem PK_left_bound : ∀ (i : Fin 48) (j : Fin 48), (Pt i j).natAbs ≤ 549984345 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 48) (j : Fin 48), (K i j).natAbs ≤ 1351199352824451677088 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 48) (j : Fin 48), (B i j).natAbs ≤ 35670647569323837869154968993280 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 48,
    PKEnc.get i = ∑ j : Fin 48, K i j * (71341295138647675738309937986561 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 48,
    shiftedEncoding 71341295138647675738309937986561 35670647569323837869154968993280 (List.ofFn fun j : Fin 48 => B i j) =
      35670647569323837869154968993280 * geometricEncoding 71341295138647675738309937986561 48 +
        ∑ j : Fin 48, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 48) (j : Fin 48) :
    B i j = ∑ k : Fin 48, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    549984345 1351199352824451677088 35670647569323837869154968993280 71341295138647675738309937986561 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
