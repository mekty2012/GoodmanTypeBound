        ∑ j : Fin 98, N i j * NGProductEnc.get j := by decide +kernel

theorem NGProduct_exact (i : Fin 104) (j : Fin 98) :
    NG i j = ∑ k : Fin 98, N i k * G k j :=
  packed_rect_product_exact N G NG
    13 224093089488672 285494596008568128 570989192017136257 (fun i => NGProductEnc.get i)
    NGProduct_left_bound NGProduct_right_bound NGProduct_result_bound
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
    NGProduct_encoded NGProduct_product i j

