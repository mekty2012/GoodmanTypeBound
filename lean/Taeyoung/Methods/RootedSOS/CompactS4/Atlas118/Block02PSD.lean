private theorem PK_left_bound : ∀ i j : Fin 58, (Pt i j).natAbs ≤ 1426446579 := by decide +kernel
private theorem PK_right_bound : ∀ i j : Fin 58, (K i j).natAbs ≤ 77560161217499446848 := by decide +kernel
private theorem PK_result_bound : ∀ i j : Fin 58, (B i j).natAbs ≤ 6416854744852652531661872113536 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 58,
    PKEnc.get i = ∑ j : Fin 58, K i j * (12833709489705305063323744227073 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 58,
    shiftedEncoding 12833709489705305063323744227073 6416854744852652531661872113536 (List.ofFn fun j : Fin 58 => B i j) =
      6416854744852652531661872113536 * geometricEncoding 12833709489705305063323744227073 58 +
        ∑ j : Fin 58, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i j : Fin 58) :
    B i j = ∑ k : Fin 58, Pt i k * K k j :=
  packed_matrix_product_exact Pt K B
    1426446579 77560161217499446848 6416854744852652531661872113536 12833709489705305063323744227073 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
