private theorem PK_left_bound : ∀ i j : Fin 59, (Pt i j).natAbs ≤ 208633160 := by decide +kernel
private theorem PK_right_bound : ∀ i j : Fin 59, (K i j).natAbs ≤ 194538128746825064646 := by decide +kernel
private theorem PK_result_bound : ∀ i j : Fin 59, (B i j).natAbs ≤ 2394639167915280239053656420240 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 59,
    PKEnc.get i = ∑ j : Fin 59, K i j * (4789278335830560478107312840481 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 59,
    shiftedEncoding 4789278335830560478107312840481 2394639167915280239053656420240 (List.ofFn fun j : Fin 59 => B i j) =
      2394639167915280239053656420240 * geometricEncoding 4789278335830560478107312840481 59 +
        ∑ j : Fin 59, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i j : Fin 59) :
    B i j = ∑ k : Fin 59, Pt i k * K k j :=
  packed_matrix_product_exact Pt K B
    208633160 194538128746825064646 2394639167915280239053656420240 4789278335830560478107312840481 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
