private theorem PK_right_bound : ∀ i j : Fin 93, (K i j).natAbs ≤ 181637097874718800662 := by decide +kernel
private theorem PK_result_bound : ∀ i j : Fin 93, (B i j).natAbs ≤ 49171021181196948035794912988916 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 93,
    PKEnc.get i = ∑ j : Fin 93, K i j * (98342042362393896071589825977833 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 93,
    shiftedEncoding 98342042362393896071589825977833 49171021181196948035794912988916 (List.ofFn fun j : Fin 93 => B i j) =
      49171021181196948035794912988916 * geometricEncoding 98342042362393896071589825977833 93 +
        ∑ j : Fin 93, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i j : Fin 93) :
    B i j = ∑ k : Fin 93, Pt i k * K k j :=
  packed_matrix_product_exact Pt K B
    2910862726 181637097874718800662 49171021181196948035794912988916 98342042362393896071589825977833 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
