private theorem PK_left_bound : ∀ (i : Fin 62) (j : Fin 62), (Pt i j).natAbs ≤ 8048833671 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 62) (j : Fin 62), (K i j).natAbs ≤ 578014858050409532448 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 62) (j : Fin 62), (B i j).natAbs ≤ 288445418012494142926623426309696 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 62,
    PKEnc.get i = ∑ j : Fin 62, K i j * (576890836024988285853246852619393 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 62,
    shiftedEncoding 576890836024988285853246852619393 288445418012494142926623426309696 (List.ofFn fun j : Fin 62 => B i j) =
      288445418012494142926623426309696 * geometricEncoding 576890836024988285853246852619393 62 +
        ∑ j : Fin 62, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 62) (j : Fin 62) :
    B i j = ∑ k : Fin 62, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    8048833671 578014858050409532448 288445418012494142926623426309696 576890836024988285853246852619393 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
