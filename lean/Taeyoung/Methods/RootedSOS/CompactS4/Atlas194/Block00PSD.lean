private theorem PK_product : ∀ i : Fin 50,
    shiftedEncoding 790969878628027183385587371571201 395484939314013591692793685785600 (List.ofFn fun j : Fin 50 => B i j) =
      395484939314013591692793685785600 * geometricEncoding 790969878628027183385587371571201 50 +
