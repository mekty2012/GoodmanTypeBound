private theorem upper : ∀ i j : Fin 23, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 23, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 23, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 23,
    (∑ j : Fin 23, if i = j then 0 else (B i j).natAbs : Nat) ≤ (B i i).toNat := by decide +kernel
private theorem positive : ∀ i : Fin 23, 0 ≤ B i i := by decide +kernel

theorem gram_nonneg (x : Fin 23 → Real) :
    0 ≤ matrixQuadratic (fun i j => (G i j : Real)) x :=
  matrixQuadratic_nonneg_of_integer_congruence
    (fun i j => G i j) (fun i j => P i j) (fun i j => K i j) (fun i j => B i j)
    upper diagonal GP_exact PK_exact symm dominant positive x

