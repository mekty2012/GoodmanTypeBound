    PKEnc.get i = ∑ j : Fin 48, K i j * (10516759847985052449403215777793 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 48,
    shiftedEncoding 10516759847985052449403215777793 5258379923992526224701607888896 (List.ofFn fun j : Fin 48 => B i j) =
      5258379923992526224701607888896 * geometricEncoding 10516759847985052449403215777793 48 +
        ∑ j : Fin 48, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 48) (j : Fin 48) :
    B i j = ∑ k : Fin 48, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    211388883 518237194856856764544 5258379923992526224701607888896 10516759847985052449403215777793 (fun i => PKEnc.get i)
