private theorem PK_left_bound : ∀ (i : Fin 62) (j : Fin 62), (Pt i j).natAbs ≤ 6049595112 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 62) (j : Fin 62), (K i j).natAbs ≤ 683593552068138272448 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 62) (j : Fin 62), (B i j).natAbs ≤ 256398781093539860604375794598912 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 62,
    PKEnc.get i = ∑ j : Fin 62, K i j * (512797562187079721208751589197825 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 62,
    shiftedEncoding 512797562187079721208751589197825 256398781093539860604375794598912 (List.ofFn fun j : Fin 62 => B i j) =
      256398781093539860604375794598912 * geometricEncoding 512797562187079721208751589197825 62 +
        ∑ j : Fin 62, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 62) (j : Fin 62) :
    B i j = ∑ k : Fin 62, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    6049595112 683593552068138272448 256398781093539860604375794598912 512797562187079721208751589197825 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
