private theorem PK_encoded : ∀ i : Fin 50,
    PKEnc.get i = ∑ j : Fin 50, K i j * (667421739015479289319606293081601 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 50,
    shiftedEncoding 667421739015479289319606293081601 333710869507739644659803146540800 (List.ofFn fun j : Fin 50 => B i j) =
      333710869507739644659803146540800 * geometricEncoding 667421739015479289319606293081601 50 +
        ∑ j : Fin 50, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 50) (j : Fin 50) :
    B i j = ∑ k : Fin 50, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    20218666742 330101755734987171648 333710869507739644659803146540800 667421739015479289319606293081601 (fun i => PKEnc.get i)
