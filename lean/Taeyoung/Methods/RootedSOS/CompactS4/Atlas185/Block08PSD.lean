private theorem upper : ∀ i j : Fin 30, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 30, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 30, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 30,
