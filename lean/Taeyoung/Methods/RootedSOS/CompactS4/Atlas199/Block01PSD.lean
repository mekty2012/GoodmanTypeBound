private theorem upper : ∀ i j : Fin 98, j < i → P i j = 0 := by decide +kernel
private theorem diagonal : ∀ i : Fin 98, P i i ≠ 0 := by decide +kernel
private theorem symm : ∀ i j : Fin 98, B i j = B j i := by decide +kernel
private theorem dominant : ∀ i : Fin 98,
