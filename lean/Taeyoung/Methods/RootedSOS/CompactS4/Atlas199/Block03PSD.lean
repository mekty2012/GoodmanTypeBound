private theorem PK_left_bound : ∀ (i : Fin 60) (j : Fin 60), (Pt i j).natAbs ≤ 344340048 := by decide +kernel
private theorem PK_right_bound : ∀ (i : Fin 60) (j : Fin 60), (K i j).natAbs ≤ 833778169921686094272 := by decide +kernel
private theorem PK_result_bound : ∀ (i : Fin 60) (j : Fin 60), (B i j).natAbs ≤ 17226192903131132756553180303360 := by decide +kernel
private theorem PK_encoded : ∀ i : Fin 60,
    PKEnc.get i = ∑ j : Fin 60, K i j * (34452385806262265513106360606721 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 60,
    shiftedEncoding 34452385806262265513106360606721 17226192903131132756553180303360 (List.ofFn fun j : Fin 60 => B i j) =
      17226192903131132756553180303360 * geometricEncoding 34452385806262265513106360606721 60 +
        ∑ j : Fin 60, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 60) (j : Fin 60) :
    B i j = ∑ k : Fin 60, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    344340048 833778169921686094272 17226192903131132756553180303360 34452385806262265513106360606721 (fun i => PKEnc.get i)
    PK_left_bound PK_right_bound PK_result_bound
