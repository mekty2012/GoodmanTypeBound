private theorem PK_encoded : ∀ i : Fin 48,
    PKEnc.get i = ∑ j : Fin 48, K i j * (29484943425362097671575709583361 : Int)^j.1 := by decide +kernel
private theorem PK_product : ∀ i : Fin 48,
    shiftedEncoding 29484943425362097671575709583361 14742471712681048835787854791680 (List.ofFn fun j : Fin 48 => B i j) =
      14742471712681048835787854791680 * geometricEncoding 29484943425362097671575709583361 48 +
        ∑ j : Fin 48, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 48) (j : Fin 48) :
    B i j = ∑ k : Fin 48, Pt i k * K k j :=
  packed_rect_product_exact Pt K B
    492344230 623821319785796719392 14742471712681048835787854791680 29484943425362097671575709583361 (fun i => PKEnc.get i)
