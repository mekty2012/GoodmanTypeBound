private theorem PK_product : ∀ i : Fin 62,
    shiftedEncoding 521579997447512701674086019751681 260789998723756350837043009875840 (List.ofFn fun j : Fin 62 => B i j) =
      260789998723756350837043009875840 * geometricEncoding 521579997447512701674086019751681 62 +
        ∑ j : Fin 62, Pt i j * PKEnc.get j := by decide +kernel

theorem PK_exact (i : Fin 62) (j : Fin 62) :
